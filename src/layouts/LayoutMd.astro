---
import type { MarkdownLayoutProps } from 'astro'
import type { Post } from '../lib/interfaces'
import { PUBLIC_GA_TRACKING_ID, ENABLE_LIGHTBOX } from '../server-constants'
import {
  getPosts,
  getRankedPosts,
  getAllTags,
  getDatabase,
} from '../lib/notion/client'
import {
  getNavLink,
  getStaticFilePath,
  getDatabaseImageURLs,
  stripBasePath,
} from '../lib/blog-helpers'
import { archiveOgImagePath } from '../lib/archive-og-image'
import '../styles/syntax-coloring.css'
import '../styles/layout-global.css'
import GoogleAnalytics from '../components/GoogleAnalytics.astro'
import SiteHead from '../components/SiteHead.astro'
import PostDate from '../components/PostDate.astro'
import BlogPostsLink from '../components/BlogPostsLink.astro'
import BlogTagsLink from '../components/BlogTagsLink.astro'
// 検索ボタンとモーダル。Layout.astro には前からあったが、こちらには
// 無かったため、アーカイブ 609 ページからは検索を開く手段が無かった。
// 置き場所も Layout.astro に合わせてある（aside の先頭とフッター直後）。
//
// ボタンの SVG・モーダルの markup・インライン化されたスクリプトが
// 各ページに載るぶん、アーカイブ記事の HTML は 1 ページあたり
// +1,322 B（gzip +254 B）増える。変更前後の dist/archive/ を
// 609 件ぶん突き合わせた実測値（14,495,912 → 15,301,010 B）。
// Layout.astro を使う 34 ページが元から払っているのと同じ費用
import SearchModal from '../components/SearchModal.astro'
import SearchButton from '../components/SearchButton.astro'

// src/pages/archive/*.md の frontmatter のうち、このレイアウトが読むものだけ。
// 全 609 件が title と date を持つ。coverImage は「行がある」のが 538 件で、
// うち値が入っているのは 515 件（23 件は空）。数え方で食い違うので注意
// NOTE: archive/index.astro にも同じ md 群を対象にした別の型宣言があるが、
// あちらが読むのは title / date / draft で、こちらとは中身が違う。
// 名前が衝突しないよう別名にしてある
interface ArchiveLayoutFrontmatter {
  title: string
  // 本文上部の日付表示と、SiteHead に渡す構造化データの datePublished を
  // 兼ねる。全 609 件が持っているので、アーカイブ記事は例外なく JSON-LD が付く
  date: string
  coverImage?: string
  // 記事側には書かれていない。remark-archive-description が本文から作って
  // file.data.astro.frontmatter に入れたものを受け取る
  description?: string
}

// Markdown レイアウトなので frontmatter / file / url などは Astro が渡す。
// title 等 4 つは分割代入側で frontmatter からデフォルト値を与えている
export type Props = MarkdownLayoutProps<ArchiveLayoutFrontmatter> & {
  title?: string
  description?: string
  path?: string
  ogImage?: string
}

const { frontmatter } = Astro.props
const [rankedPosts, tags, recentPosts] = await Promise.all([
  getRankedPosts(),
  getAllTags(),
  getPosts(5),
])

// SiteHead に渡す path は「BASE_PATH を含まない生パス」であること
// （canonical / og:url は SiteHead が getNavLink(path) で組み立てており、
// getNavLink 側が BASE_PATH を足すため）。
// Astro が渡す frontmatter.url は base 込み（BASE_PATH='/blog' なら
// '/blog/archive/100'）なので、そのまま渡すと二重に付いて
// '/blog/blog/archive/100' になる。stripBasePath() で剥がしてから渡す
const {
  title = frontmatter.title,
  // 空文字のときは SiteHead が Notion のデータベース説明に落とす。
  // 本文が取れなかった記事は従来どおりの挙動になる
  description = frontmatter.description ?? '',
  path = frontmatter.url ? stripBasePath(frontmatter.url) : frontmatter.url,
  ogImage: ogImageProp,
} = Astro.props

// coverImage をそのまま og:image に渡していたため、
// <meta property="og:image" content="DSC02362_thumb1.jpg"> のように
// URL ではなくファイル名が出力されていた。相対解決すると画像ではなく
// HTML が返るため、609 記事すべてで SNS のカード画像が出ていなかった。
//
// archiveOgImagePath() は実体があって十分な大きさのものだけパスを返す。
// 小さすぎるサムネイルは空が返り、SiteHead が共通の OGP 画像を使う
const archiveOgPath = archiveOgImagePath(frontmatter.coverImage)
const ogImage =
  ogImageProp ||
  (archiveOgPath ? new URL(archiveOgPath, Astro.site).toString() : '')

const database = await getDatabase()

const { coverImageURL, customIconURL } = getDatabaseImageURLs(database)

// PostDate に渡すためのオブジェクト。Post 全体は必要ないので、
// 実際に使う 2 つだけを持つ形で宣言する
const post: Pick<Post, 'Date' | 'Title'> = {
  Date: frontmatter.date,
  Title: frontmatter.title,
}
---

<!DOCTYPE html>
<html lang="ja" prefix="og: https://ogp.me/ns#">
  <head>
    <SiteHead
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
      articleDate={frontmatter.date}
    />
  </head>
  <body>
    <GoogleAnalytics trackingId={PUBLIC_GA_TRACKING_ID} />
    <div class="container">
      <header>
        {
          coverImageURL && (
            <div class="cover">
              <img src={coverImageURL} alt="Site cover image" loading="lazy" />
            </div>
          )
        }
      </header>

      <div>
        <main>
          <div class="content">
            <header>
              {/*
                サイト名は <h1> ではなく <p>。このレイアウトを使うのは
                アーカイブ記事 609 ページで、どれもトップページではない＝
                そのページの主題はサイト名ではなく記事タイトルなので、
                h1 は下の .archive-title に譲る。
                Layout.astro は path==='/' のときだけ h1 を出すが、
                こちらは «常にトップページではない» ので分岐が要らない
              */}
              <p class="site-title">
                <a href={getNavLink('/')}>
                  {
                    database.Icon && database.Icon.Type === 'emoji' ? (
                      <>
                        <span>{database.Icon.Emoji}</span>
                        {database.Title}
                      </>
                    ) : database.Icon && database.Icon.Type === 'external' ? (
                      <>
                        <img src={database.Icon.Url} alt="Site icon image" />
                        {database.Title}
                      </>
                    ) : database.Icon && database.Icon.Type === 'file' ? (
                      <>
                        <img src={customIconURL} class="custom-icon" alt="Site icon image" />
                        {database.Title}
                      </>
                    ) : (
                      database.Title
                    )
                  }
                </a>
              </p>
              <div class="description">
                {database.Description}
              </div>
            </header>

            <PostDate post={post} />
            {/*
              記事タイトルがこのページの主題なので <h1>。変更前は <h3> で、
              その上にサイト名の <h1> があったため、アーカイブ 609 ページは
              h1（サイト名）→ h3（記事タイトル）→ h4（本文見出し）と
              h2 を飛ばしていた（Issue #98）。
              見た目は .archive-title で h3 のときのまま据え置いている
              （下の <style is:global> を参照）
            */}
            <h1 class="archive-title">{post.Title}</h1>

            <slot />
          
            <footer>
              <div>
                <span>Powered by</span>
                <a href="https://github.com/otoyo/astro-notion-blog"
                  >astro-notion-blog</a
                >
              </div>
            </footer>
          </div>
        </main>
        <aside>
          <div>
            <SearchButton />
            <BlogPostsLink heading="おすすめ記事" posts={rankedPosts} />
            <BlogPostsLink heading="最新記事" posts={recentPosts} />
            <BlogTagsLink heading="カテゴリー" tags={tags} />
            <ul>
            <li><a href={getNavLink('/contact')}>お問い合わせ</a></li>
            <li>
              <a href={getNavLink('/posts/privacy')}>プライバシーポリシー</a>
            </li>
            <li><a href={getNavLink('/archive')}>アーカイブ一覧</a></li>
            </ul>
          </div>
        </aside>
      </div>
    </div>

    <SearchModal />
    {
      ENABLE_LIGHTBOX && (
        <script src={getStaticFilePath('/scripts/fslightbox.js')} />
      )
    }
  </body>
</html>

<style>
  /*
   * このブロックは Layout.astro と LayoutMd.astro で完全に一致している。
   * 片方だけ直すとレイアウトがずれるので、必ず両方に同じ変更を入れること
   * （diff で一致することがそのまま同期チェックになる）。
   *
   * 外部ファイルに切り出していないのは、scoped style を外に出すと
   * data-astro-cid-* が付かなくなり、適用範囲が広がってしまうため。
   * たとえば main footer は、現状スロットに差し込まれた <footer>
   * （ページネーションや前後記事リンク）には効いていないが、
   * グローバル化すると text-align: center と font-size: 0.75rem が
   * それらにも効いてしまう。global CSS を共通化した
   * src/styles/layout-global.css と違い、scoped は同じ手が使えない。
   *
   * NOTE: Layout.astro は upstream の otoyo/astro-notion-blog 由来。
   * upstream 側でこのあたりが変更されたら、LayoutMd.astro にも
   * 同じ変更を反映すること。
   */
  .container {
    min-height: 100vh;
  }

  .container > div {
    display: flex;
    max-width: 1280px;
  }
  @media (max-width: 640px) {
    .container > div {
      display: block;
    }
  }

  main {
    flex: 1;
    order: 2;
    justify-content: space-between;
  }
  @media (max-width: 640px) {
    main {
      order: 1;
    }
  }

  aside {
    order: 1;
    width: 300px;
    padding: 20px 20px;
    background-color: #f4f4f4;
  }
  @media (max-width: 640px) {
    aside {
      order: 2;
      width: 100%;
    }
  }

  div.cover {
  }
  div.cover img {
    display: block;
    width: 100%;
    height: 20vh;
    object-fit: cover;
    object-position: center 60%;
  }

  div.content {
    padding: 20px 40px;
  }
  @media (max-width: 640px) {
    div.content {
      padding: 0 18px;
    }
  }

  main header {
    padding: 20px 0 20px;
  }
  /*
   * ヘッダーのサイト名。トップページだけ <h1>、それ以外は <p> で出す
   * （Layout.astro の SiteTitleTag と LayoutMd.astro の <p class="site-title">）。
   * セレクタを h1 から .site-title に変えてあるのは、要素が変わっても
   * 同じ宣言が当たり続けるようにするため。
   *
   * margin / font-size / line-height は «h1 のときに効いていた値» を
   * そのまま書き写したもの。src/styles/layout-global.css の h1 は
   * margin:0 と font-size:2rem（640px 以下で 1.6rem）で、line-height の
   * 指定が無い＝normal。<p> にすると代わりに同ファイルの p ルール
   * （color:#222 / font-weight:400 / font-size:1rem / line-height:1.8rem）が
   * 当たるので、4 つとも明示して打ち消す。これで <h1> のときと
   * <p> のときで計算値が一致し、見た目が変わらない
   */
  main header .site-title {
    margin: 0;
    font-size: 2rem;
    line-height: normal;
    font-weight: 700;
    color: #333;
  }
  @media (max-width: 640px) {
    main header .site-title {
      font-size: 1.6rem;
    }
  }
  main header .site-title a {
    display: block;
    color: inherit;
  }
  main header .site-title a:hover {
    color: inherit;
  }
  main header .site-title a span,
  main header .site-title a img {
    display: inline-block;
    font-size: 1.1em;
  }
  main header .site-title a span {
    margin-right: 0.3em;
    margin-left: -0.1rem;
  }
  main header .site-title a img {
    width: 1.2em;
    height: 1.2em;
    margin-right: 0.2em;
    margin-left: -0.3rem;
    vertical-align: sub;
  }
  main header .site-title a img.custom-icon {
    border-radius: var(--radius);
  }

  main header div.description {
    padding: 0.3rem 0 0.6rem;
    font-size: 0.95rem;
  }

  main footer {
    margin: 30px 0 10px;
    text-align: center;
    font-size: 0.75rem;
  }
  @media (max-width: 640px) {
    main footer {
      margin: 0 auto 30px;
    }
  }
  main footer span {
    color: #777;
  }
  main footer a {
    color: inherit;
    text-decoration: underline;
  }
</style>

<style is:global>
  /* 共通部分は src/styles/layout-global.css に切り出した。
     ここには LayoutMd.astro 固有のものだけを置く */
  h2 {
    margin: 0;
    color: var(--fg);
  }

  @media (max-width: 640px) {
    h2 {
      font-size: 1.15rem;
    }

    h3 {
      font-size: 1.15rem;
    }
  }

  /*
   * アーカイブ記事のタイトル（上の <h1 class="archive-title">）。
   * 変更前は <h3> で、src/styles/layout-global.css の h3
   * （margin:0 / color:var(--fg) / font-size:1.2rem / font-weight:700）と
   * 上の @media の h3（1.15rem）が当たっていた。h1 にすると同ファイルの
   * h1（font-size:2rem、640px 以下 1.6rem）に変わり、すぐ上のサイト名と
   * «同じ大きさの太字が 2 行» 並ぶ。h3 のときの計算値を書き写して
   * 見た目を据え置く。Issue #98 で直すのは見出しの «段» であって、
   * 見た目を作り直すかどうかは別の判断
   */
  .archive-title {
    margin: 0;
    color: var(--fg);
    font-size: 1.2rem;
    font-weight: 700;
  }
  @media (max-width: 640px) {
    .archive-title {
      font-size: 1.15rem;
    }
  }

  /*
   * アーカイブ本文の見出し。src/lib/rehype-archive-headings.ts が
   * markdown の見出しをすべて h2 に揃えている（実測: 609 記事のうち
   * 397 ファイルに #### が 1,978 個、4 ファイルに # が 5 個。
   * ## / ### / ##### / ###### は 0 個）。
   *
   * 変更前の #### は h4 で、このサイトの CSS には h4 の宣言が 1 つも
   * 無いためブラウザ既定（font-size:1em / font-weight:bold /
   * margin:1.33em 0）のままだった。h2 になると
   * src/styles/layout-global.css の h2（font-size:1.2rem /
   * font-weight:normal / line-height:1.3）と、上の h2（margin:0）が
   * 当たって «太字が外れて上下の余白が消える»。既定値を書き写して
   * 見た目を据え置く。
   *
   * タグ名（.content h2）ではなく class で当てているのは、この
   * <style is:global> が «アーカイブ記事以外にも配信される» ため。
   * src/lib/archive-taxonomy.ts の import.meta.glob が
   * アーカイブの md をモジュールグラフに引き込むので、LayoutMd.astro の
   * global CSS が /category/ 27 枚・/tag/ 271 枚・/tag/ 1 枚・
   * /archive/ 1 枚にも載る（実測で 909 枚）。
   * .content h2 と書いていたときは、実際に /archive/ の
   * «カテゴリーから探す» と «すべての記事» が 1.2rem/400 から
   * 1rem/700 に変わってしまっていた。
   * class なら、CSS が配信されてもアーカイブ本文以外には当たらない
   */
  .archive-body-heading {
    margin: 1.33em 0;
    font-size: 1rem;
    font-weight: bold;
    line-height: normal;
  }

  code {
    background: #f1f1f1;
  }

  table {
    color: #222;
  }

  table tr {
    vertical-align: middle;
  }

  .content img {
    max-width: 100%;
    height: auto;
  }

  .content a {
    text-decoration: underline;
  }

  /* ヘッダーのサイト名のリンク。上の .content a が付ける下線を外す。
     変更前は .content h1 a だったが、サイト名が <p class="site-title"> に
     なって h1 では拾えなくなった。今の .content 配下の h1 は
     «記事タイトル»（.archive-title）で、中にリンクを持たない */
  .content .site-title a {
    text-decoration: none;
  }

  aside a {
    text-decoration: none;
  }
</style>
