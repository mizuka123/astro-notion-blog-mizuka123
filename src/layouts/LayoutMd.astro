---
import { PUBLIC_GA_TRACKING_ID, ENABLE_LIGHTBOX } from '../server-constants'
import {
  getPosts,
  getRankedPosts,
  getAllTags,
  getDatabase,
} from '../lib/notion/client'
import {
  getNavLink,
  getStaticFilePath,
  getDatabaseImageURLs,
} from '../lib/blog-helpers'
import '../styles/syntax-coloring.css'
import '../styles/layout-global.css'
import GoogleAnalytics from '../components/GoogleAnalytics.astro'
import SiteHead from '../components/SiteHead.astro'
import PostDate from '../components/PostDate.astro'
import BlogPostsLink from '../components/BlogPostsLink.astro'
import BlogTagsLink from '../components/BlogTagsLink.astro'
import styles from '../styles/blog.module.css'

const { frontmatter } = Astro.props;
const [rankedPosts, tags, recentPosts] = await Promise.all([
  getRankedPosts(),
  getAllTags(),
  getPosts(5),
])

export interface Props {
  title: string
  description: string
  path: string
  ogImage: string
}

const { title = frontmatter.title, description = '', path = frontmatter.url, ogImage = frontmatter.coverImage } = Astro.props

const database = await getDatabase()

const { coverImageURL, customIconURL } = getDatabaseImageURLs(database)

const asidePaddingTop = coverImageURL ? '200px' : '60px'

let post = new Object()
post.Date = frontmatter.date
post.Title = frontmatter.title
---

<!DOCTYPE html>
<html lang="ja" prefix="og: https://ogp.me/ns#">
  <head>
    <SiteHead
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
    />
  </head>
  <body>
    <GoogleAnalytics trackingId={PUBLIC_GA_TRACKING_ID} />
    <div class="container">
      <main>
        {
          coverImageURL && (
            <div class="cover">
              <img src={coverImageURL} alt="Site cover image" loading="lazy" />
            </div>
          )
        }

        <div class="content">
          <header>
            <h1>
              <a href={getNavLink('/')}>
                {
                  database.Icon && database.Icon.Type === 'emoji' ? (
                    <>
                      <span>{database.Icon.Emoji}</span>
                      {database.Title}
                    </>
                  ) : database.Icon && database.Icon.Type === 'external' ? (
                    <>
                      <img src={database.Icon.Url} alt="Site icon image" />
                      {database.Title}
                    </>
                  ) : database.Icon && database.Icon.Type === 'file' ? (
                    <>
                      <img src={customIconURL} class="custom-icon" alt="Site icon image" />
                      {database.Title}
                    </>
                  ) : (
                    database.Title
                  )
                }
              </a>
            </h1>
            <div class="description">
              {database.Description}
            </div>
          </header>

          <PostDate post={post} />
          <h3>{post.Title}</h3>

          <slot />
          
          <footer>
            <div>
              <span>Powered by</span>
              <a href="https://github.com/otoyo/astro-notion-blog"
                >astro-notion-blog</a
              >
            </div>
          </footer>
        </div>
      </main>

      <aside>
        <div class={styles.aside}>
          <BlogPostsLink heading="おすすめ記事" posts={rankedPosts} />
          <BlogPostsLink heading="最新記事" posts={recentPosts} />
          <BlogTagsLink heading="カテゴリー" tags={tags} />
          <ul>
          <li><a href="/contact">お問い合わせ</a></li>
          <li><a href="/posts/privacy">プライバシーポリシー</a></li>
          <li><a href="/archive">アーカイブ一覧</a></li>
          </ul>
        </div>
      </aside>
    </div>

    {
      ENABLE_LIGHTBOX && (
        <script src={getStaticFilePath('/scripts/fslightbox.js')} />
      )
    }
  </body>
</html>

<style define:vars={{ asidePaddingTop }}>
  .container {
    display: flex;
    min-height: 100vh;
  }
  @media (max-width: 640px) {
    .container {
      display: block;
    }
  }

  main {
    flex: 1;
    order: 2;
    justify-content: space-between;
  }
  @media (max-width: 640px) {
    main {
      order: 1;
    }
  }

  aside {
    order: 1;
    width: 300px;
    padding: var(--asidePaddingTop) 20px 20px;
    background-color: #f4f4f4;
  }
  @media (max-width: 640px) {
    aside {
      order: 2;
      width: 100%;
      padding: 40px 20px 20px;
    }
  }

  div.cover {
  }
  div.cover img {
    display: block;
    width: 100%;
    height: 20vh;
    object-fit: cover;
    object-position: center 60%;
  }

  div.content {
    padding: 20px 40px;
  }
  @media (max-width: 640px) {
    div.content {
      padding: 0 18px;
    }
  }

  main header {
    padding: 20px 0 20px;
  }
  main header h1 {
    font-weight: 700;
    color: #333;
  }
  main header h1 a {
    display: block;
    color: inherit;
  }
  main header h1 a:hover {
    color: inherit;
  }
  main header h1 a span,
  main header h1 a img {
    display: inline-block;
    font-size: 1.1em;
  }
  main header h1 a span {
    margin-right: 0.3em;
    margin-left: -0.1rem;
  }
  main header h1 a img {
    width: 1.2em;
    height: 1.2em;
    margin-right: 0.2em;
    margin-left: -0.3rem;
    vertical-align: sub;
  }
  main header h1 a img.custom-icon {
    border-radius: var(--radius);
  }

  main header div.description {
    padding: 0.3rem 0 0.6rem;
    font-size: 0.95rem;
  }

  main footer {
    margin: 30px 0 10px;
    text-align: center;
    font-size: 0.75rem;
  }
  @media (max-width: 640px) {
    main footer {
      margin: 0 auto 30px;
    }
  }
  main footer span {
    color: #777;
  }
  main footer a {
    color: inherit;
    text-decoration: underline;
  }
</style>

<style is:global>
  /* 共通部分は src/styles/layout-global.css に切り出した。
     ここには LayoutMd.astro 固有のものだけを置く */
  h2 {
    margin: 0;
    color: var(--fg);
  }

  @media (max-width: 640px) {
    h2 {
      font-size: 1.15rem;
    }

    h3 {
      font-size: 1.15rem;
    }
  }

  code {
    background: #f1f1f1;
  }

  table {
    color: #222;
  }

  table tr {
    vertical-align: middle;
  }

  .content img {
    max-width: 100%;
    height: auto;
  }

  .content a {
    text-decoration: underline;
  }

  .content h1 a {
    text-decoration: none;
  }

  aside a {
    text-decoration: none;
  }
</style>
