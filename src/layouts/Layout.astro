---
import { PUBLIC_GA_TRACKING_ID, ENABLE_LIGHTBOX } from '../server-constants'
import { getDatabase } from '../lib/notion/client'
import {
  getNavLink,
  getStaticFilePath,
  getDatabaseImageURLs,
} from '../lib/blog-helpers'
import '../styles/syntax-coloring.css'
import '../styles/layout-global.css'
import GoogleAnalytics from '../components/GoogleAnalytics.astro'
import SiteHead from '../components/SiteHead.astro'
import SearchModal from '../components/SearchModal.astro'
import SearchButton from '../components/SearchButton.astro'

// すべて省略可能。分割代入側でデフォルト値を与えている
export interface Props {
  title?: string
  description?: string
  path?: string
  ogImage?: string
  // 404 ページ用。SiteHead に素通しする（canonical を出さず noindex にする）
  noindex?: boolean
}

// path のデフォルトは '/'（トップページ）。省略するとそのページの canonical と
// og:url がトップページを指してしまい、検索エンジンには「このページは重複」と
// 宣言したことになる（実際に /archive/ と /contact/ で起きた）。
// トップページ以外からは必ず path を渡すこと。
// 書式は他ページに合わせて末尾スラッシュ無し（例: '/archive'）
const {
  title = '',
  description = '',
  path = '/',
  ogImage = '',
  noindex = false,
} = Astro.props

const database = await getDatabase()

const { coverImageURL, customIconURL } = getDatabaseImageURLs(database)
---

<!DOCTYPE html>
<html lang="ja" prefix="og: https://ogp.me/ns#">
  <head>
    <SiteHead
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
      noindex={noindex}
    />
  </head>
  <body>
    <GoogleAnalytics trackingId={PUBLIC_GA_TRACKING_ID} />
    <div class="container">
      <header>
        {
          coverImageURL && (
            <div class="cover">
              <img src={coverImageURL} alt="Site cover image" loading="lazy" />
            </div>
          )
        }
      </header>

      <div>
        <main>
          <div class="content">
            <header>
              <h1>
                <a href={getNavLink('/')}>
                  {
                    database.Icon && database.Icon.Type === 'emoji' ? (
                      <>
                        <span>{database.Icon.Emoji}</span>
                        {database.Title}
                      </>
                    ) : database.Icon && database.Icon.Type === 'external' ? (
                      <>
                        <img src={database.Icon.Url} alt="Site icon image" />
                        {database.Title}
                      </>
                    ) : database.Icon && database.Icon.Type === 'file' ? (
                      <>
                        <img
                          src={customIconURL}
                          class="custom-icon"
                          alt="Site icon image"
                        />
                        {database.Title}
                      </>
                    ) : (
                      database.Title
                    )
                  }
                </a>
              </h1>
              <div class="description">
                {database.Description}
              </div>
            </header>

            <slot name="main" />

            <footer>
              <div>
                <span>Powered by&nbsp;</span>
                <a href="https://github.com/otoyo/astro-notion-blog"
                  >astro-notion-blog</a
                >
              </div>
            </footer>
          </div>
        </main>
        <aside>
          <SearchButton />
          <slot name="aside" />
          <ul>
          <li><a href={getNavLink('/contact')}>お問い合わせ</a></li>
          <li>
            <a href={getNavLink('/posts/privacy')}>プライバシーポリシー</a>
          </li>
          <li><a href={getNavLink('/archive')}>アーカイブ一覧</a></li>
          </ul>
        </aside>
      </div>
    </div>

    <SearchModal />
    {
      ENABLE_LIGHTBOX && (
        <script src={getStaticFilePath('/scripts/fslightbox.js')} />
      )
    }
  </body>
</html>

<style>
  /*
   * このブロックは Layout.astro と LayoutMd.astro で完全に一致している。
   * 片方だけ直すとレイアウトがずれるので、必ず両方に同じ変更を入れること
   * （diff で一致することがそのまま同期チェックになる）。
   *
   * 外部ファイルに切り出していないのは、scoped style を外に出すと
   * data-astro-cid-* が付かなくなり、適用範囲が広がってしまうため。
   * たとえば main footer は、現状スロットに差し込まれた <footer>
   * （ページネーションや前後記事リンク）には効いていないが、
   * グローバル化すると text-align: center と font-size: 0.75rem が
   * それらにも効いてしまう。global CSS を共通化した
   * src/styles/layout-global.css と違い、scoped は同じ手が使えない。
   *
   * NOTE: Layout.astro は upstream の otoyo/astro-notion-blog 由来。
   * upstream 側でこのあたりが変更されたら、LayoutMd.astro にも
   * 同じ変更を反映すること。
   */
  .container {
    min-height: 100vh;
  }

  .container > div {
    display: flex;
    max-width: 1280px;
  }
  @media (max-width: 640px) {
    .container > div {
      display: block;
    }
  }

  main {
    flex: 1;
    order: 2;
    justify-content: space-between;
  }
  @media (max-width: 640px) {
    main {
      order: 1;
    }
  }

  aside {
    order: 1;
    width: 300px;
    padding: 20px 20px;
    background-color: #f4f4f4;
  }
  @media (max-width: 640px) {
    aside {
      order: 2;
      width: 100%;
    }
  }

  div.cover {
  }
  div.cover img {
    display: block;
    width: 100%;
    height: 20vh;
    object-fit: cover;
    object-position: center 60%;
  }

  div.content {
    padding: 20px 40px;
  }
  @media (max-width: 640px) {
    div.content {
      padding: 0 18px;
    }
  }

  main header {
    padding: 20px 0 20px;
  }
  main header h1 {
    font-weight: 700;
    color: #333;
  }
  main header h1 a {
    display: block;
    color: inherit;
  }
  main header h1 a:hover {
    color: inherit;
  }
  main header h1 a span,
  main header h1 a img {
    display: inline-block;
    font-size: 1.1em;
  }
  main header h1 a span {
    margin-right: 0.3em;
    margin-left: -0.1rem;
  }
  main header h1 a img {
    width: 1.2em;
    height: 1.2em;
    margin-right: 0.2em;
    margin-left: -0.3rem;
    vertical-align: sub;
  }
  main header h1 a img.custom-icon {
    border-radius: var(--radius);
  }

  main header div.description {
    padding: 0.3rem 0 0.6rem;
    font-size: 0.95rem;
  }

  main footer {
    margin: 30px 0 10px;
    text-align: center;
    font-size: 0.75rem;
  }
  @media (max-width: 640px) {
    main footer {
      margin: 0 auto 30px;
    }
  }
  main footer span {
    color: #777;
  }
  main footer a {
    color: inherit;
    text-decoration: underline;
  }
</style>

<style is:global>
  /* 共通部分は src/styles/layout-global.css に切り出した。
     ここには Layout.astro 固有のものだけを置く */
  body {
    -webkit-text-size-adjust: 100%;
  }

  a {
    text-decoration: none;
  }

  h2 {
    margin: 0;
    padding: 1em 1.1em;
    margin-top: 2.1em;
    margin-bottom: 1em;
  }

  code {
    background: rgba(135, 131, 120, 0.15);
  }

  table {
    display: block;
    overflow-x: auto;
    white-space: nowrap;
  }

  table tr {
    vertical-align: top;
  }

  table td,
  table th {
    text-align: left;
  }
  table td::after {
    content: '';
    display: inline-block;
    min-height: 0.9rem;
  }
</style>
