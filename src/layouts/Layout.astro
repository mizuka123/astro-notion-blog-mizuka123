---
import { PUBLIC_GA_TRACKING_ID, ENABLE_LIGHTBOX } from '../server-constants'
import { getDatabase } from '../lib/notion/client'
import {
  getNavLink,
  getStaticFilePath,
  getDatabaseImageURLs,
} from '../lib/blog-helpers'
import '../styles/syntax-coloring.css'
import '../styles/layout-global.css'
import GoogleAnalytics from '../components/GoogleAnalytics.astro'
import SiteHead from '../components/SiteHead.astro'
import SearchModal from '../components/SearchModal.astro'
import SearchButton from '../components/SearchButton.astro'

// すべて省略可能。分割代入側でデフォルト値を与えている
export interface Props {
  title?: string
  description?: string
  path?: string
  ogImage?: string
  // robots に noindex を出す。SiteHead に素通しする。
  // canonical と og:url は落とさない（それは下の noCanonical の役目）
  noindex?: boolean
  // canonical と og:url を出さない。SiteHead に素通しする。
  // URL が固定されない 404 ページ用で、渡しているのは src/pages/404.astro だけ
  noCanonical?: boolean
  // 広告とアフィリエイトのスクリプトを出さない。SiteHead に素通しする
  noAds?: boolean
  // 記事ページ（/posts/[slug]）だけが渡す公開日。SiteHead に素通しする。
  // 渡した場合だけ記事用の JSON-LD が出る。一覧系（index / posts/page /
  // posts/tag）と 404 は渡さないので、記事用の型が付くことはない
  articleDate?: string
  // 記事用の JSON-LD の image。SiteHead に素通しする。
  // 空なら JSON-LD に image を出さない（共通画像には落とさない）
  articleImage?: string
  // KaTeX の CSS を読み込む。SiteHead に素通しする。
  // 本文に数式がある Notion 記事（/posts/[slug]）だけが渡す
  katexCss?: boolean
}

// path のデフォルトは '/'（トップページ）。省略するとそのページの canonical と
// og:url がトップページを指してしまい、検索エンジンには「このページは重複」と
// 宣言したことになる（実際に /archive/ と /contact/ で起きた）。
// トップページ以外からは必ず path を渡すこと。
// 書式は他ページに合わせて末尾スラッシュ無し（例: '/archive'）
const {
  title = '',
  description = '',
  path = '/',
  ogImage = '',
  noindex = false,
  noCanonical = false,
  noAds = false,
  articleDate = '',
  articleImage = '',
  katexCss = false,
} = Astro.props

const database = await getDatabase()

const { coverImageURL, customIconURL } = getDatabaseImageURLs(database)

// ヘッダーのサイト名をどの要素で出すか。
//
// 変更前は全 942 ページで <h1> がサイト名だった。h1 は «そのページが何に
// ついてのページか» を示す唯一の見出しなので、942 ページ全部が
// 「みずかるちゃー」というページになっていたことになる。記事ページでは
// 記事タイトル、一覧ページでは一覧の名前が h1 でなければならない。
//
// サイト名が主題として正しいのはトップページだけなので、そこだけ h1 に
// 残し、それ以外では «見出しではない» <p> にする。見出しを消すのではなく
// 段を下げないのは、h2 にするとページの主題（h1）より前に h2 が出てしまい、
// 「サイト名はこのページの一節」という嘘の構造になるため。
//
// path のデフォルトが '/' なので、path を渡していないページ＝トップページ。
// 実際に path を渡していないのは src/pages/index.astro だけ（実測）
const SiteTitleTag = path === '/' ? 'h1' : 'p'
---

<!DOCTYPE html>
<html lang="ja" prefix="og: https://ogp.me/ns#">
  <head>
    <SiteHead
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
      noindex={noindex}
      noCanonical={noCanonical}
      noAds={noAds}
      articleDate={articleDate}
      articleImage={articleImage}
      katexCss={katexCss}
    />
  </head>
  <body>
    <GoogleAnalytics trackingId={PUBLIC_GA_TRACKING_ID} />
    <div class="container">
      <header>
        {
          coverImageURL && (
            <div class="cover">
              <img src={coverImageURL} alt="" loading="lazy" />
            </div>
          )
        }
      </header>

      <div>
        <main>
          <div class="content">
            <header>
              <SiteTitleTag class="site-title">
                <a href={getNavLink('/')}>
                  {
                    database.Icon && database.Icon.Type === 'emoji' ? (
                      <>
                        <span>{database.Icon.Emoji}</span>
                        {database.Title}
                      </>
                    ) : database.Icon && database.Icon.Type === 'external' ? (
                      <>
                        <img src={database.Icon.Url} alt="" />
                        {database.Title}
                      </>
                    ) : database.Icon && database.Icon.Type === 'file' ? (
                      <>
                        <img
                          src={customIconURL}
                          class="custom-icon"
                          alt=""
                        />
                        {database.Title}
                      </>
                    ) : (
                      database.Title
                    )
                  }
                </a>
              </SiteTitleTag>
              <div class="description">
                {database.Description}
              </div>
            </header>

            <slot name="main" />

            <footer>
              <div>
                <span>Powered by&nbsp;</span>
                <a href="https://github.com/otoyo/astro-notion-blog"
                  >astro-notion-blog</a
                >
              </div>
            </footer>
          </div>
        </main>
        <aside>
          <SearchButton />
          <slot name="aside" />
          <ul>
          <li><a href={getNavLink('/contact')}>お問い合わせ</a></li>
          <li>
            <a href={getNavLink('/posts/privacy')}>プライバシーポリシー</a>
          </li>
          <li><a href={getNavLink('/archive')}>アーカイブ一覧</a></li>
          </ul>
        </aside>
      </div>
    </div>

    <SearchModal />
    {
      ENABLE_LIGHTBOX && (
        <script src={getStaticFilePath('/scripts/fslightbox.js')} />
      )
    }
  </body>
</html>

<style>
  /*
   * このブロックは Layout.astro と LayoutMd.astro で完全に一致している。
   * 片方だけ直すとレイアウトがずれるので、必ず両方に同じ変更を入れること
   * （diff で一致することがそのまま同期チェックになる）。
   *
   * 外部ファイルに切り出していないのは、scoped style を外に出すと
   * data-astro-cid-* が付かなくなり、適用範囲が広がってしまうため。
   * たとえば main footer は、現状スロットに差し込まれた <footer>
   * （ページネーションや前後記事リンク）には効いていないが、
   * グローバル化すると text-align: center と font-size: 0.75rem が
   * それらにも効いてしまう。global CSS を共通化した
   * src/styles/layout-global.css と違い、scoped は同じ手が使えない。
   *
   * NOTE: Layout.astro は upstream の otoyo/astro-notion-blog 由来。
   * upstream 側でこのあたりが変更されたら、LayoutMd.astro にも
   * 同じ変更を反映すること。
   */
  .container {
    min-height: 100vh;
  }

  .container > div {
    display: flex;
    max-width: 1280px;
  }
  @media (max-width: 640px) {
    .container > div {
      display: block;
    }
  }

  main {
    flex: 1;
    order: 2;
    justify-content: space-between;
  }
  @media (max-width: 640px) {
    main {
      order: 1;
    }
  }

  aside {
    order: 1;
    width: 300px;
    padding: 20px 20px;
    background-color: #f4f4f4;
  }
  @media (max-width: 640px) {
    aside {
      order: 2;
      width: 100%;
    }
  }

  div.cover {
  }
  div.cover img {
    display: block;
    width: 100%;
    height: 20vh;
    object-fit: cover;
    object-position: center 60%;
  }

  div.content {
    padding: 20px 40px;
  }
  @media (max-width: 640px) {
    div.content {
      padding: 0 18px;
    }
  }

  main header {
    padding: 20px 0 20px;
  }
  /*
   * ヘッダーのサイト名。トップページだけ <h1>、それ以外は <p> で出す
   * （Layout.astro の SiteTitleTag と LayoutMd.astro の <p class="site-title">）。
   * セレクタを h1 から .site-title に変えてあるのは、要素が変わっても
   * 同じ宣言が当たり続けるようにするため。
   *
   * margin / font-size / line-height は «h1 のときに効いていた値» を
   * そのまま書き写したもの。src/styles/layout-global.css の h1 は
   * margin:0 と font-size:2rem（640px 以下で 1.6rem）で、line-height の
   * 指定が無い＝normal。<p> にすると代わりに同ファイルの p ルール
   * （color:#222 / font-weight:400 / font-size:1rem / line-height:1.8rem）が
   * 当たるので、4 つとも明示して打ち消す。これで <h1> のときと
   * <p> のときで計算値が一致し、見た目が変わらない
   */
  main header .site-title {
    margin: 0;
    font-size: 2rem;
    line-height: normal;
    font-weight: 700;
    color: #333;
  }
  @media (max-width: 640px) {
    main header .site-title {
      font-size: 1.6rem;
    }
  }
  main header .site-title a {
    display: block;
    color: inherit;
  }
  main header .site-title a:hover {
    color: inherit;
  }
  main header .site-title a span,
  main header .site-title a img {
    display: inline-block;
    font-size: 1.1em;
  }
  main header .site-title a span {
    margin-right: 0.3em;
    margin-left: -0.1rem;
  }
  main header .site-title a img {
    width: 1.2em;
    height: 1.2em;
    margin-right: 0.2em;
    margin-left: -0.3rem;
    vertical-align: sub;
  }
  main header .site-title a img.custom-icon {
    border-radius: var(--radius);
  }

  main header div.description {
    padding: 0.3rem 0 0.6rem;
    font-size: 0.95rem;
  }

  main footer {
    margin: 30px 0 10px;
    text-align: center;
    font-size: 0.75rem;
  }
  @media (max-width: 640px) {
    main footer {
      margin: 0 auto 30px;
    }
  }
  main footer span {
    color: #777;
  }
  main footer a {
    color: inherit;
    text-decoration: underline;
  }
</style>

<style is:global>
  /* 共通部分は src/styles/layout-global.css に切り出した。
     ここには Layout.astro 固有のものだけを置く */
  body {
    -webkit-text-size-adjust: 100%;
  }

  a {
    text-decoration: none;
  }

  h2 {
    margin: 0;
    padding: 1em 1.1em;
    margin-top: 2.1em;
    margin-bottom: 1em;
  }

  code {
    background: rgba(135, 131, 120, 0.15);
  }

  table {
    display: block;
    overflow-x: auto;
    white-space: nowrap;
  }

  table tr {
    vertical-align: top;
  }

  table td,
  table th {
    text-align: left;
  }
  table td::after {
    content: '';
    display: inline-block;
    min-height: 0.9rem;
  }
</style>
