---
import { getPosts, getRankedPosts, getAllTags } from '../lib/notion/client.ts'
import Layout from '../layouts/Layout.astro'
import BlogPostsLink from '../components/BlogPostsLink.astro'
import BlogTagsLink from '../components/BlogTagsLink.astro'
import styles from '../styles/blog.module.css'


// index.astro からコピーしたときに受け取り側だけ 3 つに減らしたため、
// 変数と中身が 1 つずつずれていた。「最新記事」にタグの配列が渡って
// /posts/undefined へのリンクが 5 本出力され、「Categories」には
// ランキング記事が渡って There are no contents yet になっていた。
// このページはページ送りをしないので、使う 3 つだけを呼ぶ
// （archive/index.astro と LayoutMd.astro も同じ形）
const [rankedPosts, tags, recentPosts] = await Promise.all([
  getRankedPosts(),
  getAllTags(),
  getPosts(5),
])

// description を渡さないと SiteHead が Notion のデータベース説明文
// 「ガジェットやカメラ、ちょっとだけ技術の話題が中心のブログ」に
// フォールバックする。実測で dist 全 942 ページのうち 10 ページが
// この同じ 1 文を共有しており、このページもその 1 つだった。
// ブログの内容を説明する文がお問い合わせページに出ていると、
// 検索結果ではトップページや一覧ページと見分けが付かない。
//
// 他の 8 ページと違って一覧ではないので件数は入れられない。
// 代わりに «このページに実際にあるもの» だけを書く。本文は下の
// Google フォーム（docs.google.com/forms の embedded=true）の iframe
// 1 つだけで、それ以外の説明文もメールアドレスも置いていないため、
// 書けるのは「フォームがあり、この画面から送信できる」ことまで
const description =
  '当ブログへのお問い合わせページです。Google フォームを埋め込んでいるので、この画面から直接送信できます。'
---

<Layout title="お問い合わせ" description={description} path="/contact">
  <div slot="main" class={styles.main}>
    {/*
      このページには見出しが 1 つも無く、h1 はサイト名だった（Issue #98）。
      本文は下の Google フォームの iframe だけで、iframe の中身は
      このページの見出しにはならない。文言は上の Layout に渡している
      title（＝<title> の「お問い合わせ」）と同じにする。
      見た目は他の一覧系ページの見出しと同じ
      （src/styles/blog.module.css の .pageHeading）
    */}
    <h1 class={styles.pageHeading}>お問い合わせ</h1>
    <iframe src="https://docs.google.com/forms/d/e/1FAIpQLSccUwCJD4wFdKdkM6cBI-Q9tiWgAwz-Z-xYgOX42leyc3Pong/viewform?embedded=true" width="100%" height="900" frameborder="0" marginheight="0" marginwidth="0">読み込んでいます…</iframe>
  </div>

  <div slot="aside">
    <BlogPostsLink heading="おすすめ記事" posts={rankedPosts} />
    <BlogPostsLink heading="最新記事" posts={recentPosts} />
    <BlogTagsLink heading="カテゴリー" tags={tags} />
  </div>
</Layout>
