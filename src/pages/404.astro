---
import { getPosts, getRankedPosts, getAllTags } from '../lib/notion/client.ts'
import { getNavLink } from '../lib/blog-helpers.ts'
import Layout from '../layouts/Layout.astro'
import BlogPostsLink from '../components/BlogPostsLink.astro'
import BlogTagsLink from '../components/BlogTagsLink.astro'
import styles from '../styles/blog.module.css'

// このファイルが無いと Cloudflare Pages は未マッチのパスに対して
// トップページを «200» で返す。実測では /wp-login.php でも
// /category/gadget/ でもトップと同じ 29,434 バイトが 200 で返っていた。
// 存在しない URL がすべてトップの重複としてインデックスされうる。
// dist/404.html があれば Pages がそれを 404 ステータスで返す。
//
// 読者の行き止まりにしないよう、サイドバーは他のページと同じものを出す。
//
// noindex / noCanonical / noAds を 3 つとも渡すのはこのページだけ。それぞれ
// 理由が違う: 検索結果に出す意味が無い（noindex）、どの URL で配信されるか
// 決まっていないので「この URL が正規」と名乗れない（noCanonical）、
// 行き止まりの画面への広告配信が Google Publisher Policies に触れる（noAds）。
// /category/ と /tag/ の薄いページは URL が実在するので noCanonical は渡さない
const [rankedPosts, tags, recentPosts] = await Promise.all([
  getRankedPosts(),
  getAllTags(),
  getPosts(5),
])
---

<Layout
  title="ページが見つかりません"
  description="お探しのページは見つかりませんでした。"
  path="/404"
  noindex
  noCanonical
  noAds
>
  <div slot="main" class={styles.main}>
    <h2>ページが見つかりません</h2>
    <p>
      お探しのページは、移動または削除された可能性があります。URL
      に誤りが無いかご確認ください。
    </p>
    <ul>
      <li><a href={getNavLink('/')}>トップページ</a></li>
      <li><a href={getNavLink('/archive')}>アーカイブ一覧</a></li>
      <li><a href={getNavLink('/contact')}>お問い合わせ</a></li>
    </ul>
  </div>

  <div slot="aside" class={styles.aside}>
    <BlogPostsLink heading="おすすめ記事" posts={rankedPosts} />
    <BlogPostsLink heading="最新記事" posts={recentPosts} />
    <BlogTagsLink heading="カテゴリー" tags={tags} />
  </div>
</Layout>
