---
import {
  getPosts,
  getRankedPosts,
  getAllTags,
} from '../../lib/notion/client'
import {
  archiveCategories,
  archiveTags,
  compareSlugs,
  getCategoryDisplayName,
} from '../../lib/archive-taxonomy'
import { archiveEntries } from '../../lib/archive-frontmatter'
import { getNavLink, stripBasePath } from '../../lib/blog-helpers'
import Layout from '../../layouts/Layout.astro'
import BlogPostsLink from '../../components/BlogPostsLink.astro'
import BlogTagsLink from '../../components/BlogTagsLink.astro'
import styles from '../../styles/blog.module.css'
import taxonomyStyles from '../../styles/archive-taxonomy.module.css'

const [rankedPosts, tags, recentPosts] = await Promise.all([
  getRankedPosts(),
  getAllTags(),
  getPosts(5),
])

const siteTitle = 'アーカイブ一覧'

// md を import.meta.glob の eager で «モジュールとして» 読むと、md の layout
// である LayoutMd.astro の global CSS がこのページにも載る（#123）。
// frontmatter だけを読む archive-frontmatter.ts から受け取る。
// 0 件のときは向こうが例外でビルドを止める。
// sort は元の配列を並べ替えるので、共有の archiveEntries を直接並べ替えないよう
// filter で作った新しい配列を並べる
const nonDraftPosts = archiveEntries.filter((post) => !post.frontmatter.draft)
const sortedPosts = nonDraftPosts.sort((a, b) => {
  const aDate = new Date(a.frontmatter.date)
  const bDate = new Date(b.frontmatter.date)
  return bDate.getTime() - aDate.getTime()
})

// このページの導線は «609 本の平坦なリンク» だけで、読者が目当ての分野に
// たどり着く手段が無かった。カテゴリー 27 件を先頭に置いて入口を作る。
// タグは 271 種あり、ここに並べると本来の記事一覧が画面外に押し出される
// ので、下の indexableTagCount のリンク 1 本だけを置いて /tag/ に送る。
//
// 並びは記事数の多い順。スラッグ順（accessory が先頭）だと 1 本しか
// 無い pc-web と 95 本の camera-lens が同じ重みで並ぶ。
// 同数のときはスラッグ順にして、ビルドごとに入れ替わらないようにする
const categoryLinks = [...archiveCategories.entries()]
  .map(([slug, taxonomy]) => ({
    slug,
    name: getCategoryDisplayName(slug),
    count: taxonomy.posts.length,
  }))
  .sort((a, b) => b.count - a.count || compareSlugs(a.slug, b.slug))

// タグページ 271 枚は、この行が無いとサイト内のどこからもリンクされない
// 孤立ページになる（実測: dist 全 941 ページで href="/tag/ は 0 件）。
// ここに 271 件を展開すると本来の記事一覧が画面外に出るので、
// 入口だけを 1 本置いて、その先の /tag/ に index 対象のタグを並べる
const indexableTagCount = [...archiveTags.values()].filter(
  (taxonomy) => taxonomy.indexable
).length

// description を渡さないと SiteHead が Notion のデータベース説明文
// 「ガジェットやカメラ、ちょっとだけ技術の話題が中心のブログ」に
// フォールバックする。実測で dist 全 942 ページのうち 10 ページがこの
// 同じ 1 文を共有しており（このページもその 1 つ）、検索エンジンからは
// どれも同じページに見える。書き方は #112 の /category/<slug>/ と
// /tag/ に合わせ、件数を入れて «どのページか» が文だけで分かるようにする。
// 数字はすべて上で数えた実値（実測: 記事 609 件 / カテゴリー 27 件）
const description = `アーカイブ記事 ${sortedPosts.length} 件をすべて並べた一覧です。カテゴリー ${categoryLinks.length} 件からも辿れます。`
---

<Layout
  title={siteTitle}
  description={description}
  path="/archive"
>
  <div slot="main" class={styles.main}>
    {/*
      このページには «ページの主題を示す見出し» が無く、h1 はサイト名、
      本文の先頭がいきなり「カテゴリーから探す」の h2 だった（Issue #98）。
      文言は上の Layout に渡している siteTitle（＝<title> の「アーカイブ一覧」）
      と同じにして、タブのタイトルと画面の見出しを食い違わせない。
      見た目は既にある h2 と同じ（src/styles/blog.module.css の .pageHeading）
    */}
    <h1 class={styles.pageHeading}>{siteTitle}</h1>
    <h2>カテゴリーから探す</h2>
    <ul class={taxonomyStyles.taxonomyLinks}>
      {
        categoryLinks.map((category) => (
          <li>
            {/*
              件数を隣に置くだけでは、読み上げで「ガジェット 61」としか
              伝わらない。aria-label でリンク自身に「何の 61 なのか」を
              持たせ、見た目の数字は aria-hidden で二重読みを防ぐ
            */}
            <a
              href={getNavLink(`/category/${category.slug}`)}
              aria-label={`${category.name} の記事一覧（${category.count} 件）`}
            >
              {category.name}
            </a>
            <span class={taxonomyStyles.count} aria-hidden="true">
              {category.count}
            </span>
          </li>
        ))
      }
    </ul>
    <p class="tag-index">
      <a
        href={getNavLink('/tag')}
        aria-label={`タグから探す（${indexableTagCount} 件）`}
      >
        タグから探す
      </a>
      <span class={taxonomyStyles.count} aria-hidden="true">
        {indexableTagCount}
      </span>
    </p>

    <h2>すべての記事</h2>
    {/*
      記事一覧は ul で囲む（Issue #111）。以前は div の直下に li が並んでいて
      HTML として不正で、支援技術に «609 項目のリスト» として伝わらなかった。
      見た目は変えないため、ul に当たる余白や文字の指定は下の .post-list で打ち消している
    */}
    <ul class="post-list">
      {
        sortedPosts.map((post) => (
          <li>
            <a href={getNavLink(stripBasePath(post.url))}>
              {post.frontmatter.title}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div slot="aside">
    <BlogPostsLink heading="おすすめ記事" posts={rankedPosts} />
    <BlogPostsLink heading="最新記事" posts={recentPosts} />
    <BlogTagsLink heading="カテゴリー" tags={tags} />
  </div>
</Layout>

<style>
  /* 横並びの見た目そのものは src/styles/archive-taxonomy.module.css に
     置いて /tag/ と共有している。ここはこのページ固有の間隔だけ */
  p.tag-index {
    margin: 0.6rem 0 0;
  }

  /* 記事一覧の ul（Issue #111）。ul で囲む前の見た目（li が div の直下にあり、
     記事名の左端が本文の左端に揃い、黒丸は本文の左の外にぶら下がる。最初の
     行は直前の h2 の下端に接し、行の間隔は line-height: normal）を 1 px も
     変えないため、ul に当たる指定を打ち消す。
     - margin / padding: ブラウザ既定（上下 1em、左 40px）と、
       src/styles/layout-global.css の ul,ol { margin: 0;
       padding-inline-start: 1.5rem } の両方を 0 に戻す
     - color / font-weight / font-size / line-height: layout-global.css の
       p,ul { color: #222; font-weight: 400; font-size: 1rem;
       line-height: 1.8rem } が li に継承されると行の間隔（24.8px →
       28.8px）と黒丸の色が変わるので、囲む前と同じく親の div から継承させる
     list-style は既定の disc / outside が今の見た目そのものなので指定しない。
     ページ全体の ul に効かないよう、クラスで限定する（#123 の二の舞を避ける） */
  ul.post-list {
    margin: 0;
    padding: 0;
    color: inherit;
    font-weight: inherit;
    font-size: inherit;
    line-height: inherit;
  }

  /* 記事一覧と「タグから探す」のリンクの下線（#123）。
     src/layouts/LayoutMd.astro の .content a { text-decoration: underline } が
     漏れて当たっていたもので、#123 で漏れを止めた後も公開中の見た目を保つ。
     カテゴリー一覧の下線は src/styles/archive-taxonomy.module.css の
     .taxonomyLinks a で当てている */
  ul.post-list a,
  p.tag-index a {
    text-decoration: underline;
  }

  /* 「カテゴリーから探す」「すべての記事」の h2（#123）。
     Layout.astro の h2 は margin: 2.1em 0 1em だが、このページでは
     src/layouts/LayoutMd.astro の h2 { margin: 0 } と、640px 以下の
     h2 { font-size: 1.15rem } が漏れて当たっていた。#123 で漏れを止めた
     後も公開中の見た目を保つため、同じ値をここに書く。
     このページの <style> は scoped なので h2[data-astro-cid-*] に変換され、
     このテンプレートが直接出す h2（この 2 つ）にしか当たらない。サイドバーの
     h2 は別のコンポーネントのもので対象外。h2 に class を足さないのは、
     マークアップを変えずに «漏れていたときの見た目» だけを戻すため */
  h2 {
    margin: 0;
  }
  @media (max-width: 640px) {
    h2 {
      font-size: 1.15rem;
    }
  }
</style>
