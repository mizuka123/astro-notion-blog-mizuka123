---
import type { ArchivePostRef } from '../../lib/archive-taxonomy'
import { archiveTags } from '../../lib/archive-taxonomy'
import { getPosts, getRankedPosts, getAllTags } from '../../lib/notion/client'
import { getNavLink } from '../../lib/blog-helpers'
import Layout from '../../layouts/Layout.astro'
import BlogPostsLink from '../../components/BlogPostsLink.astro'
import BlogTagsLink from '../../components/BlogTagsLink.astro'
import styles from '../../styles/blog.module.css'
import taxonomyStyles from '../../styles/archive-taxonomy.module.css'

// 旧 WordPress の /tag/<slug>/ に «実ページ» を置く。理由は
// src/pages/category/[category].astro と同じ（#92 で 404 になった旧 URL を
// 200 に戻す）。
//
// Notion 記事側のタグは /posts/tag/<tag>/ が受け持っていて、こちらとは
// 別系統。同じ「タグ」でも母集団（アーカイブ 609 記事 / Notion 記事）も
// URL も違うので、1 つのページにまとめていない。
//
// タグには表示名の対応表を作らずスラッグをそのまま出す。271 種のうち
// 185 種は noindex のページ（記事 2 本以下が 181 種、記事集合が他の
// タクソノミーと完全一致するものが 4 種）で、手で 271 行を維持する労力に
// 見合わない（src/lib/archive-taxonomy.ts の対応表のコメント参照）
export async function getStaticPaths() {
  // props で posts を渡す理由はカテゴリー側と同じ。271 種のうち 86 種が
  // 日本語スラッグで、params 経由だと URL エンコードの往復が挟まる
  return [...archiveTags.entries()].map(([tag, taxonomy]) => ({
    params: { tag },
    props: {
      posts: taxonomy.posts,
      indexable: taxonomy.indexable,
      thin: taxonomy.thin,
    },
  }))
}

export interface Props {
  posts: ArchivePostRef[]
  // src/pages/category/[category].astro と同じ。判断条件は
  // src/lib/archive-taxonomy.ts にだけ置き、ここは結果を受け取るだけ
  indexable: boolean
  thin: boolean
}

const { tag } = Astro.params
const { posts, indexable, thin } = Astro.props

// noindex は indexable、noAds は thin と «別々の» 条件で渡している。
// 理由は src/pages/category/[category].astro のコメントを参照
// （薄いページへの広告配信が Google Publisher Policies の
// Inventory value に触れる。一方 «重複で index から外しただけ» の
// ページは薄くないので広告は止めない）

// ページごとに書き分ける。271 ページが同じ説明文だと検索エンジンからは
// 区別が付かない（#99 と同じ方針）
const title = `${tag} の記事一覧`
const description = `「${tag}」タグを付けたアーカイブ記事 ${posts.length} 件の一覧です。`

// 日付を getDateStr() に通さず post.date をそのまま出す理由は
// src/pages/category/[category].astro のコメントを参照
// （ローカル時刻を経由して 1 日ずれるため）

const [rankedPosts, tags, recentPosts] = await Promise.all([
  getRankedPosts(),
  getAllTags(),
  getPosts(5),
])
---

<Layout
  title={title}
  description={description}
  path={`/tag/${tag}`}
  noindex={!indexable}
  noAds={thin}
>
  <div slot="main" class={styles.main}>
    <h2>{title}</h2>
    <p>{description}</p>
    <ul class={taxonomyStyles.entries}>
      {
        posts.map((post) => (
          <li>
            <time datetime={post.date}>{post.date}</time>
            <a href={getNavLink(post.url)}>{post.title}</a>
          </li>
        ))
      }
    </ul>
  </div>

  <div slot="aside" class={styles.aside}>
    <BlogPostsLink heading="おすすめ記事" posts={rankedPosts} />
    <BlogPostsLink heading="最新記事" posts={recentPosts} />
    <BlogTagsLink heading="カテゴリー" tags={tags} />
  </div>
</Layout>
