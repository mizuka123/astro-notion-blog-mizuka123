---
import * as interfaces from '../../lib/interfaces.ts'
import {
  getPosts,
  getAllPosts,
  getRankedPosts,
  getPostBySlug,
  getPostsByTag,
  getBlock,
  getAllTags,
  getAllBlocksByBlockId,
  downloadFiles,
} from '../../lib/notion/client.ts'
import fs from 'node:fs'
import {
  filePath,
  extractTargetBlocks,
  ogImageUrlPath,
  ogImageLocalPath,
} from '../../lib/blog-helpers.ts'
import { descriptionFromBlocks } from '../../lib/notion-description.ts'
import { hasEquation } from '../../lib/notion-equation.ts'
import Layout from '../../layouts/Layout.astro'
import PostDate from '../../components/PostDate.astro'
import PostTags from '../../components/PostTags.astro'
import PostTitle from '../../components/PostTitle.astro'
import PostBody from '../../components/PostBody.astro'
import PostRelativeLink from '../../components/PostRelativeLink.astro'
import BlogPostsLink from '../../components/BlogPostsLink.astro'
import BlogTagsLink from '../../components/BlogTagsLink.astro'
import styles from '../../styles/blog.module.css'

export async function getStaticPaths() {
  const posts = await getAllPosts()
  return posts.map((post: interfaces.Post) => ({ params: { slug: post.Slug } }))
}

const { slug } = Astro.params

const post = await getPostBySlug(slug)
if (!post) {
  throw new Error(`Post not found. slug: ${slug}`)
}

const [blocks, allPosts, rankedPosts, recentPosts, tags, postsHavingSameTag] =
  await Promise.all([
    getAllBlocksByBlockId(post.PageId),
    getAllPosts(),
    getRankedPosts(),
    getPosts(5),
    getAllTags(),
    getPostsByTag(post.Tags[0]?.name, 6),
  ])

// video も同じ経路で落とす。アップロードした動画（file タイプ）の URL は
// 署名付きで失効するため、ローカルに持っておかないと描画できない。
// ここならレンダリングに使う blocks をそのまま流用でき、
// 「ダウンロードしていない URL を src に書く」隙ができない
//
// 注意: downloadFiles は REQUEST_TIMEOUT_MS（src/server-constants.ts、
// 既定 10 秒）でレスポンス待ちと転送の停滞を打ち切る。動画は画像より遥かに
// 大きく転送も長いので、回線が細い・不安定な環境では画像より停滞判定に
// 引っかかりやすい。打ち切られると downloadFiles が throw してビルドが
// 失敗するため、その場合は環境変数 REQUEST_TIMEOUT_MS を伸ばして対処する
// （定数の既定値を上げると他のダウンロードにも効いてしまうので変えない）
const fileAtacchedBlocks = extractTargetBlocks('image', blocks)
  .concat(extractTargetBlocks('file', blocks))
  .concat(extractTargetBlocks('video', blocks))
  .filter((block) => {
    if (!block) {
      return false
    }
    const imageOrFile = block.Image || block.File || block.Video
    return imageOrFile && imageOrFile.File && imageOrFile.File.Url
  })

// Download files
const fileUrls = await Promise.all(
  fileAtacchedBlocks.map(async (block) => {
    const expiryTime = (block.Image || block.File || block.Video).File.ExpiryTime
    const latestBlock =
      Date.parse(expiryTime) > Date.now() ? block : await getBlock(block.Id)
    return (latestBlock.Image || latestBlock.File || latestBlock.Video).File.Url
  })
)

// callout の file タイプのアイコンも同じ経路で落とす。
// 記事アイコンと違ってブロックを辿らないと分からないが、ここなら
// レンダリングに使う blocks をそのまま流用できる。別のタイミングで
// ブロックを取り直すと、落とした URL と描画する URL がずれて
// 「ダウンロードしていないファイルを src に書く」隙ができる
const calloutIconUrls = extractTargetBlocks('callout', blocks)
  .map((block) =>
    block.Callout?.Icon?.Type === 'file' ? block.Callout.Icon.Url : undefined
  )
  .filter((url): url is string => !!url)

await downloadFiles(`posts/${slug}`, [...fileUrls, ...calloutIconUrls])

const currentPostIndex = allPosts.findIndex((post) => post.Slug === slug)
const prevPost = allPosts[currentPostIndex + 1]
const nextPost = allPosts[currentPostIndex - 1]

let ogImage = ''
if (post.FeaturedImage && post.FeaturedImage.Url) {
  const featuredImageUrl = new URL(post.FeaturedImage.Url)

  // og-image-generator が作った 1200x630 があればそちらを使う。
  // FeaturedImage をそのまま渡すと、縦長のスクリーンショットは SNS 側で
  // 1.91:1 に切られて中央の帯しか出ず、数 MB の画像がそのまま配信される。
  // 生成できなかった記事は元画像に戻す（og:image が空になるよりよい）
  // ogImage は string なので、URL のまま入れると型が合わない
  // （元から ts(2322) が出ていた箇所。触るついでに直している）
  ogImage = new URL(
    fs.existsSync(ogImageLocalPath(featuredImageUrl))
      ? ogImageUrlPath(featuredImageUrl)
      : filePath(featuredImageUrl),
    Astro.site
  ).toString()
}

// 下の Layout に渡す path は「BASE_PATH を含まない生パス」であること。
// canonical / og:url は SiteHead が getNavLink(path) で組み立てており、
// getNavLink 側が BASE_PATH を足すため、ここで getPostLink()（BASE_PATH 込み）
// を渡すと二重に付いて /blog/blog/posts/<slug> のように壊れる。
// 一覧系ページ（/posts/page/N など）もすべて生パスを渡している
//
// articleDate は構造化データの datePublished になる。Notion の Date
// プロパティが未設定だと client.ts が空文字を入れるため、SiteHead 側で
// 空なら JSON-LD ごと出さない。日付の無い記事に嘘の日付を付けないため
//
// articleImage は構造化データの image。og:image と同じ画像を渡す。
// FeaturedImage が無い記事では空になり、JSON-LD に image を出さない
// （og:image は共通画像に落ちるが、記事を表さない画像を構造化データで
// «この記事の画像» と申告しない）。実測では 23 記事すべてに
// FeaturedImage があり、この分岐に入る記事は今は無い
//
// katexCss は本文に数式（数式ブロックかインライン数式）があるときだけ
// true。判定には描画に使う blocks をそのまま渡す。別に取り直すと、
// 判定したブロックと描画するブロックがずれて «数式があるのに CSS が無い»
// 隙ができる。実測（2026-09-24）では Notion 記事 23 件に数式は無く、
// 今は全記事で false になる
---

<Layout
  title={post.Title}
  description={post.Excerpt.trim() || descriptionFromBlocks(blocks)}
  path={`/posts/${post.Slug}`}
  ogImage={ogImage}
  articleImage={ogImage}
  articleDate={post.Date}
  katexCss={hasEquation(blocks)}
>
  <div slot="main" class={styles.main}>
    <div class={styles.post}>
      <PostDate post={post} />
      <PostTags post={post} />
      {/* 記事タイトルがこのページの主題なので h1 にする（Issue #98）。
          一覧ページで同じ PostTitle を使うところは h2 のまま */}
      <PostTitle post={post} enableLink={false} isPageHeading />
      <PostBody blocks={blocks} />
      <PostTags post={post} />

      <footer>
        <PostRelativeLink prevPost={prevPost} nextPost={nextPost} />
      </footer>
    </div>
  </div>

  <div slot="aside">
    <BlogPostsLink
      heading="同じカテゴリー記事"
      posts={postsHavingSameTag.filter(
        (p: interfaces.Post) => p.Slug !== post.Slug
      )}
    />
    <BlogPostsLink heading="おすすめ記事" posts={rankedPosts} />
    <BlogPostsLink heading="最新記事" posts={recentPosts} />
    <BlogTagsLink heading="カテゴリー" tags={tags} />
  </div>
</Layout>
