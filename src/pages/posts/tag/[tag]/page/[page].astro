---
import type { SelectProperty } from '../../../../../lib/interfaces.ts'
import { NUMBER_OF_POSTS_PER_PAGE } from '../../../../../server-constants.ts'
import {
  getPosts,
  getPostsByTag,
  getPostsByTagAndPage,
  getRankedPosts,
  getAllTags,
  getNumberOfPagesByTag,
} from '../../../../../lib/notion/client.ts'
import Layout from '../../../../../layouts/Layout.astro'
import NoContents from '../../../../../components/NoContents.astro'
import PostDate from '../../../../../components/PostDate.astro'
import PostTags from '../../../../../components/PostTags.astro'
import PostTitle from '../../../../../components/PostTitle.astro'
import PostFeaturedImage from '../../../../../components/PostFeaturedImage.astro'
import PostExcerpt from '../../../../../components/PostExcerpt.astro'
import ReadMoreLink from '../../../../../components/ReadMoreLink.astro'
import Pagination from '../../../../../components/Pagination.astro'
import BlogPostsLink from '../../../../../components/BlogPostsLink.astro'
import BlogTagsLink from '../../../../../components/BlogTagsLink.astro'
import styles from '../../../../../styles/blog.module.css'
import '../../../../../styles/notion-color.css'

export async function getStaticPaths() {
  const allTags = await getAllTags()

  let params = []

  await Promise.all(
    allTags.map((tag: SelectProperty) => {
      return getNumberOfPagesByTag(tag.name).then((numberOfPages: number) => {
        for (let i = 2; i <= numberOfPages; i++) {
          params.push({ params: { tag: tag.name, page: i.toString() } })
        }
      })
    })
  )

  return params
}

const { tag, page } = Astro.params

// このページは現在 0 枚しか生成されない。getStaticPaths が 2 ページ目以降を
// 作るのは記事が NUMBER_OF_POSTS_PER_PAGE（10）件を超えたタグだけで、
// 実測ではタグ 5 件の記事数が 9 / 9 / 2 / 2 / 2 件と全て 10 件以下のため。
// それでも <title> と description を /posts/tag/<tag>/ と揃えて直しておく。
// 記事が 1 件増えて 11 件になった時点で «英語の title とサイト共通の
// description を持つページ» が突然生えてくるのを防ぐため
//
// allTaggedPosts は «そのタグの全記事数» を description に入れるために取る。
// getPostsByTagAndPage() が返すのはこのページの分（最大 10 件）だけ。
// どちらも getAllPosts() のメモリキャッシュを絞り込むだけなので
// Notion へのリクエストは増えない
const [posts, allTaggedPosts, rankedPosts, tags, numberOfPages, recentPosts] =
  await Promise.all([
    getPostsByTagAndPage(tag, parseInt(page, 10)),
    getPostsByTag(tag, Number.MAX_SAFE_INTEGER),
    getRankedPosts(),
    getAllTags(),
    getNumberOfPagesByTag(tag),
    getPosts(5),
  ])

const currentTag = posts[0].Tags.find((t) => t.name === tag)

// 何件目から何件目を載せているか。getPostsByTagAndPage() と同じ
// NUMBER_OF_POSTS_PER_PAGE 区切りなので開始位置はページ番号から出せる。
// 終わりは posts.length から出す（最終ページは 10 件に満たない）
const firstPostNumber = (parseInt(page, 10) - 1) * NUMBER_OF_POSTS_PER_PAGE + 1
const lastPostNumber = firstPostNumber + posts.length - 1

// <title> は /posts/tag/<tag>/（1 ページ目）の «◯◯ の記事一覧» に
// 「N/M ページ目」を足した形。変更前は 'Posts in ガジェット 2/3' だった。
// 数字を「2/3」のままにしているのは /posts/page/<n> と同じ理由で、
// 画面上部の見出しと Pagination が元からこの表記を使っているため
// «「」で括ったタグの» にする理由は /posts/tag/[tag].astro のコメントを参照。
//
// なお posts/page/[page].astro では «検索結果で切られる 30 文字» を
// 目安に «2/3 ページ目» の形を選んだが、こちらはタグ名の長さ次第で
// その予算を超える（「ポケモンスリープ」タグの記事一覧 2/2 ページ目 -
// みずかるちゃー で 37 文字）。タグ名は削れないので、
// 切られることを承知のうえで 1 ページ目との一貫性を優先している
const title = `「${tag}」タグの記事一覧 ${page}/${numberOfPages} ページ目`

// description を渡さないと Notion のデータベース説明文にフォールバックし、
// サイト共通の 1 文を使い回すページがまた増える。件数と «何件目から
// 何件目か» を入れて、同じタグの 1 ページ目とも別ページとも重ならない文にする
const description = `「${tag}」タグが付いた記事 ${allTaggedPosts.length} 件のうち、新しい順に ${firstPostNumber}〜${lastPostNumber} 件目（${page}/${numberOfPages} ページ目）です。`
---

<Layout
  title={title}
  description={description}
  path={`/posts/tag/${tag}/page/${page}`}
>
  <div slot="main" class={styles.main}>
    <header>
      {/*
        h1 にする理由とチップの扱いは src/pages/posts/tag/[tag].astro と
        同じ（Issue #98）。文言は上の title と揃えて «N/M ページ目» まで出す。
        変更前は «ガジェット 2/3» とだけ出ていた。
        なお上のコメントのとおり、このページは現在 0 枚しか生成されない
      */}
      <h1 class="tag-container">
        <span class={`tag ${currentTag.color}`}>{tag}</span> タグの記事一覧 {
          page
        }/{numberOfPages} ページ目
      </h1>
    </header>

    {
      posts.length === 0 ? (
        <NoContents contents={posts} />
      ) : (
        posts.map((post) => (
          <div class={styles.post} key={post.Slug}>
            <PostDate post={post} />
            <PostTags post={post} />
            <PostTitle post={post} />
            <PostFeaturedImage post={post} />
            <PostExcerpt post={post} />
            <ReadMoreLink post={post} />
          </div>
        ))
      )
    }

    <footer>
      <Pagination
        tag={tag}
        currentPage={parseInt(page, 10)}
        numberOfPages={numberOfPages}
      />
    </footer>
  </div>

  <Fragment slot="aside">
    <BlogPostsLink heading="おすすめ記事" posts={rankedPosts} />
    <BlogPostsLink heading="最新記事" posts={recentPosts} />
    <BlogTagsLink heading="タグ" tags={tags} />
  </Fragment>
</Layout>

<style>
  .tag-container {
    margin: 0;
    line-height: 1.3;
    font-size: 1.2rem;
    font-weight: normal;
  }
  @media (max-width: 640px) {
    .tag-container {
      font-size: 1.15rem;
    }
  }
  .tag-container span.tag {
    border-radius: 4px;
    padding: 3px 9px;
    background: var(--tag-bg-light-gray);
  }
</style>
