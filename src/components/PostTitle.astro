---
import { Post } from '../lib/interfaces.ts'
import { getIconImageURL, getPostLink } from '../lib/blog-helpers.ts'

export interface Props {
  post: Post
  // 分割代入側でデフォルト値を与えている
  enableLink?: boolean
}

const { post, enableLink = true } = Astro.props

let title = post.Title

// enableLink の true/false で同じ分岐を 2 回書くので、ここで一度だけ求める。
// file タイプ（署名付き URL が失効する）はローカルパスに差し替わる
const iconImageURL = getIconImageURL(post.Icon)
---

<h2 class="post-title">
  {
    enableLink ? (
      <a href={getPostLink(post.Slug)}>
        {post.Icon && post.Icon.Type === 'emoji' ? (
          <>
            <span>{post.Icon.Emoji}</span>
            {title}
          </>
        ) : iconImageURL ? (
          <>
            <img src={iconImageURL} alt="Post title icon" />
            {title}
          </>
        ) : (
          title
        )}
      </a>
    ) : (
      <>
        {post.Icon && post.Icon.Type === 'emoji' ? (
          <>
            <span>{post.Icon.Emoji}</span>
            {title}
          </>
        ) : iconImageURL ? (
          <>
            <img src={iconImageURL} alt="Post title icon" />
            {title}
          </>
        ) : (
          title
        )}
      </>
    )
  }
</h2>

<style>
  .post-title {
    margin: 0;
    padding: 0.2rem 0;
    font-size: 2rem;
    font-weight: 700;
    color: var(--fg);
  }
  .post-title a {
    font-size: 1.6rem;
    color: inherit;
  }
  .post-title span,
  .post-title img {
    display: inline-block;
    margin-right: 0.2em;
  }
  .post-title span {
    font-size: 1.2em;
  }
  .post-title img {
    width: 1.3em;
    height: 1.3em;
    vertical-align: sub;
  }
  @media (max-width: 640px) {
    .post-title {
      font-size: 1.4rem;
    }
    .post-title a {
      font-size: 1.2rem;
    }
  }
</style>
