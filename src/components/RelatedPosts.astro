---
import { getDateStr } from '../lib/blog-helpers.ts'

// 記事本文の直後に出す「関連記事」。アーカイブ記事（LayoutMd.astro）と
// Notion の記事（pages/posts/[slug].astro）の両方で使うので、
// 記事の型ではなく表示に要る 3 つだけを受け取る。href は BASE_PATH 込み
export interface RelatedPost {
  title: string
  href: string
  date?: string
}

export interface Props {
  posts: RelatedPost[]
}

const { posts } = Astro.props
---

{
  posts.length > 0 && (
    <section class="related-posts">
      <h2>関連記事</h2>
      <ul>
        {posts.map((post) => (
          <li>
            <a href={post.href}>
              <span class="title">{post.title}</span>
              {post.date && (
                <time datetime={post.date}>{getDateStr(post.date)}</time>
              )}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  /* LayoutMd.astro の <style is:global>（.content a の下線、h2 の
     margin: 0 など）や Notion 記事側の h2 の padding-left に負けない
     よう、すべて .related-posts の下に書き、余白も明示する */
  .related-posts {
    margin: 2.5rem 0 1.5rem;
  }
  .related-posts h2 {
    margin: 0 0 0.6rem;
    padding: 0 0.4rem 0.4rem;
    border-bottom: 2px solid rgba(55, 53, 47, 0.16);
    font-size: 1.1rem;
  }
  .related-posts ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .related-posts li + li {
    border-top: 1px solid rgba(55, 53, 47, 0.09);
  }
  .related-posts a {
    display: block;
    padding: 0.7rem 0.4rem;
    color: inherit;
    text-decoration: none;
  }
  .related-posts a:hover {
    background: rgba(55, 53, 47, 0.04);
  }
  .related-posts .title {
    display: block;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .related-posts a:hover .title {
    text-decoration: underline;
  }
  .related-posts time {
    display: block;
    margin-top: 0.15rem;
    color: #777;
    font-size: 0.8rem;
  }
</style>
