---
import { getStaticFilePath } from '../lib/blog-helpers'

// インデックスの URL は Astro 側で組み立てて data 属性で渡す。
// 以前は script の中で location から `${protocol}//${hostname}${port}/feed`
// を組み直していたが、これだと BASE_PATH がサブディレクトリに設定された
// 環境で 404 になる（現在の BASE_PATH は '' なので表には出ていなかった）。
// define:vars を使わないのは、そちらだとスクリプトがビルドの処理から
// 外れてしまうため。
//
// ただし «バンドルに入るので各ページには載らない» わけではない。実測では
// このスクリプトは _astro/ の js に出ておらず、minify された状態で
// 全 942 ページの HTML に直接埋め込まれている（1 ページ 3,049 バイト）。
// ここを 1 行増やすと 942 倍の費用になることに注意
const searchIndexPath = getStaticFilePath('/search-index.json')
---

<div class="search-modal-container" data-search-index={searchIndexPath}>
  <div class="overlay"></div>

  <div class="search-modal">
    <div class="search-prompt">
      <input type="text" placeholder="Search..." />
    </div>
    <div class="search-result">
      <ul>
        <li class="selected">
          <a href="#">
            <div class="search-result-title"></div>
            <div class="search-result-description"></div>
          </a>
        </li>
      </ul>
    </div>
  </div>
</div>

<style>
  div.search-modal-container {
    display: none;
  }

  div.overlay {
    z-index: 99;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
  }

  div.search-modal {
    z-index: 100;
    position: fixed;
    top: 100px;
    left: 20%;
    width: 60%;
    border-radius: 6px;
    background-color: var(--bg);
  }
  @media (max-width: 640px) {
    div.search-modal {
      left: 0;
      width: 100%;
    }
  }

  div.search-prompt {
    margin: 6px 0;
    padding: 0 6px;
  }
  div.search-prompt input {
    width: 100%;
    border: 0px solid transparent;
    padding: 0.4rem;
    background-color: var(--input-bg);
    color: var(--fg);
    font-size: 1.2rem;
    line-height: 1.6rem;
  }

  div.search-result {
    border-top: 1px solid var(--hr-border);
  }
  div.search-result ul {
    list-style: none;
    margin: 0.3rem;
    padding: 0;
  }
  div.search-result ul > :global(li) {
  }
  div.search-result ul > :global(li > a) {
    display: block;
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius);
  }
  div.search-result ul > :global(li.selected > a) {
    background-color: rgba(241, 241, 239, 1);
  }

  div.search-result :global(div.search-result-title) {
    padding: 0.1rem 0;
    color: var(--fg);
    font-size: 1.1rem;
    line-height: 1.2rem;
    font-weight: bold;
  }
  div.search-result :global(div.search-result-description) {
    margin: 0 0 0.1rem;
    color: var(--fg);
    font-size: 0.9rem;
    line-height: 1.2rem;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    let feedItems = []
    let fetched = false

    // 一度に描画する上限。アーカイブ 609 件が加わって対象が 632 件になり、
    // 空欄で開いたときや「の」のような頻出文字を打ったときに全件が
    // <li> になる。以前は最大 23 件だったので上限が要らなかっただけで、
    // 632 件を毎キーストロークで作り直すのは無駄でしかない。
    // 一覧は縦に並ぶだけで 20 件より下はどのみちスクロールしないと見えない
    const MAX_RESULTS = 20

    // 押しただけでは入力欄の文字が変わらないキー（handleKeydown() で使う）。
    // AltGraph は Windows で AltGr を押したときに届く
    const MODIFIER_KEYS = ['Control', 'Shift', 'Alt', 'AltGraph', 'Meta']

    // 検索の照合に使う «畳んだ» 文字列を作る。
    //
    // 素の includes() は大文字小文字を区別するため、632 件のうち
    // 442 件のタイトルに A-Z が含まれるこの索引では取りこぼしが大きい。
    // 実測で iphone / sony / ipad / galaxy / kindle / android / pc は
    // すべて 0 件だった（iPhone なら 14 件、SONY なら 17 件出る）。
    // 読者は普通に小文字で打つので、そのままでは «検索しても出てこない»。
    //
    // NFKC まで掛けているのは、日本語 IME で全角のまま打つことが
    // 日常的に起きるため。実測で ｉｐｈｏｎｅ（全角）は 0 件 → 14 件、
    // ﾚﾋﾞｭｰ（半角カナ）は 0 件 → 152 件になる。索引側に全角英数を含む
    // タイトルは 5 件、半角カナは 4 件しかないので、これは主に «入力側»
    // の揺れを吸収するためのもの
    //
    // ?? '' は外せない。索引 632 件のうち «アーカイブ記事 609 件は
    // description のキー自体を持たない»（空文字ですらない）。
    // 変更前は item?.description?.includes() と呼び出し側に書いてあったので
    // 見えていたが、今はこの中に隠れている。外すと 1 クエリが空振りする
    // だけでは済まず、索引取得時の map() の中で TypeError になって
    // モーダルごと動かなくなる
    //
    // 波ダッシュ 〜（U+301C）だけは NFKC で畳まれないので自前で ~ にする。
    // 全角チルダ ～（U+FF5E）は NFKC で ~ になるが 〜 は変わらず、両者が
    // 相互に当たらなかった。Windows の IME は ～、macOS は 〜 を出しがちで、
    // 索引 632 件のタイトルにも ～ が 30 件、〜 が 2 件と両方が混ざっている。
    // 実測でクエリ ～ / 〜 はそれぞれ 30 件 / 2 件 → どちらも 32 件になる。
    //
    // 同種の «見た目が同じで符号位置が違う» 文字を索引で数えた結果、
    // 畳むのは 〜 だけにした（件数はタイトルのもの。description は 632 件
    // すべて空かキー無しで、どの文字も 0 件）:
    // - ∼ U+223C / ‐ U+2010 / − U+2212 / — U+2014 / ‒ U+2012 は 0 件
    //   （－ U+FF0D も 0 件で、どのみち NFKC で - になる）
    // - ― U+2015 は 2 件（To LOVEる―とらぶる―）あるが、対になる — は 0 件で
    //   索引の中では揺れていない。記号のダッシュで検索する読者も想定しにくい
    // - 長音符 ー U+30FC は 294 件あるが、これは記号ではなく語の一部。
    //   - と同一視すると - で引いたときに レビュー のような語を含む 294 件が
    //   混ざり、- を含む 126 件（型番など）を探せなくなるので畳まない
    const foldForSearch = (text) =>
      (text ?? '')
        .normalize('NFKC')
        .replace(/\u301C/g, '~')
        .toLowerCase()

    async function openModal() {
      document.querySelector('.search-modal-container').style.display = 'block'
      document.querySelector('.search-prompt input').focus()

      if (!fetched) {
        await fetchSearchIndex()
      }
      searchAndRender()
    }

    function closeModal() {
      document.querySelector('.search-modal-container').style.display = 'none'
    }

    function handleKeydown(event) {
      // モーダルが閉じているときは何もしない。
      //
      // このハンドラは document に張ってあるため、ガードが無いと
      // ページを普通に読んでいるだけの読者のキー入力まで横取りする。
      // 本番のブラウザで実測したところ、モーダルが display:none の状態でも
      // ↑↓ が preventDefault() され «ページが矢印キーでスクロールしない»、
      // Enter は初期 markup の <a href="#"> を click して先頭へジャンプ＋
      // 履歴が 1 つ増える、という状態だった。
      // 一度検索文字を入れた後は結果リストが空になるため、Enter は
      // null 参照で TypeError になる。なお «開いていてヒット 0 件» のときの
      // 同種の TypeError はこのガードでは塞がらない。そちらは select() /
      // selectUp() / selectDown() の側で «対象が無ければ何もしない» として塞ぐ
      //
      // 元からあったが、アーカイブ 609 記事にも検索を付けたことで
      // «矢印キーでのスクロールが最も使われる長文ページ» に広がった
      //
      // 判定は openModal()/closeModal() が書いたインラインスタイルを直接読む。
      // クロージャに isOpen のような変数を別に持たないのは、開閉状態の出所を
      // DOM ひとつに保つため（変数と DOM の二重管理はずれたときに気づけない）。
      // その代わり «隠し方» にこの条件が結合している。class の付け外しや
      // [hidden] / <dialog> に変えるときは、必ずこの条件も一緒に直すこと。
      // 直し忘れると判定が常に真になり «モーダルを開いてもキー操作が効かない»
      // という逆向きの壊れ方を、エラーも出さずにする
      const container = document.querySelector('.search-modal-container')
      if (!container || container.style.display !== 'block') {
        return
      }

      if (event.keyCode === 13) {
        // Enter
        select()
      } else if (event.keyCode === 27) {
        // ESC
        closeModal()
      } else if (event.keyCode === 38) {
        // Up
        selectUp(event)
      } else if (event.keyCode === 40) {
        // Down
        selectDown(event)
      } else if (
        !MODIFIER_KEYS.includes(event.key) &&
        !(event.keyCode === 75 && (event.ctrlKey || event.metaKey))
      ) {
        // 修飾キー単独の押下と、検索を開くショートカット（Ctrl+K / Cmd+K）
        // では描き直さない。
        //
        // searchAndRender() は結果を作り直して先頭を選び直すので、↑↓ で
        // 2 件目以降を選んだ後に Ctrl や Shift を押しただけで選択位置が
        // 先頭に戻っていた。開いている状態での Ctrl+K も同じ経路で戻る
        // （SearchButton.astro 側は開いていれば click() しないが、この
        // ハンドラも同じ keydown を受けるため、ここでも除く必要がある）。
        // どちらも入力欄の文字を変えないので、描き直す理由が無い。
        //
        // なお keydown の時点では今の打鍵の文字はまだ入力欄に入っていないので、
        // 描画は «1 打鍵前の文字列» で行われている。修飾キーで描き直すと
        // その遅れがたまたま追いついていたが、それは次の文字キーでも追いつく
        searchAndRender()
      }
    }

    function select() {
      // 結果が 0 件のときは選ぶものが無いので何もしない。
      //
      // どの記事にも当たらない語を打つと renderResults() が ul を空にし、
      // selectFirst() も li が無いので何も選ばない。その状態で Enter を
      // 押すと a が null のまま click() して TypeError になっていた。
      // 索引は «アーカイブ記事は title と link だけ» なので、本文にしか
      // 出てこない語はすべて 0 件になり、この経路は日常的に踏まれる
      const a = document.querySelector('.search-result ul > li.selected a')
      if (!a) {
        return
      }
      a.click()
    }

    function selectFirst() {
      const li = document.querySelector('.search-result ul > li:first-child')
      if (li) {
        li.classList.add('selected')
      }
    }

    function selectUp(event) {
      // preventDefault() は結果が 0 件でも呼ぶ（下のガードより先に置く）。
      //
      // «モーダルが開いている間は入力欄にフォーカスがあるので、既定動作を
      // 通してもページはスクロールしない» とは言い切れない。フォーカスを
      // 入力欄に移すのは openModal() の 1 回だけで、その後モーダルの余白
      // （入力欄の周りや結果欄の枠）をクリックすると、そこはフォーカスを
      // 受け取れない要素なのでフォーカスは body に落ちる。モーダルは開いた
      // ままで、背後のページにスクロールを止める仕掛けも無いため、ここで
      // 既定動作を通すと «オーバーレイの裏で記事がスクロールする»。
      // 入力欄にフォーカスがある場合でも、ブラウザによっては ↑↓ で
      // キャレットが先頭 / 末尾に飛ぶ。結果があるときは ↑↓ でそれが
      // 起きないので、0 件のときだけ起きるのは挙動として揃わない
      event.preventDefault()

      const ul = document.querySelector('.search-result ul')
      // 結果が 0 件のときは移る先が無いので何もしない。
      // ul が空だと lastElementChild が null で TypeError になっていた
      // （preventDefault() が先に走るので、例外が出ても見た目は無反応だった）
      if (!ul.lastElementChild) {
        return
      }
      const selected = ul.querySelector('.selected')
      if (selected) {
        selected.classList.remove('selected')

        if (selected.previousElementSibling) {
          selected.previousElementSibling.classList.add('selected')
        } else {
          ul.lastElementChild.classList.add('selected')
        }
      } else {
        ul.lastElementChild.classList.add('selected')
      }
    }

    function selectDown(event) {
      // 0 件でも preventDefault() を先に呼ぶ理由は selectUp() と同じ
      event.preventDefault()

      const ul = document.querySelector('.search-result ul')
      // 結果が 0 件のときは移る先が無いので何もしない（selectUp() と対称）
      if (!ul.firstElementChild) {
        return
      }
      const selected = ul.querySelector('.selected')
      if (selected) {
        selected.classList.remove('selected')

        if (selected.nextElementSibling) {
          selected.nextElementSibling.classList.add('selected')
        } else {
          ul.firstElementChild.classList.add('selected')
        }
      } else {
        ul.firstElementChild.classList.add('selected')
      }
    }

    function handleMouseover(event) {
      Array.from(event.target.closest('ul').children).forEach((element) => {
        element.classList.remove('selected')
      })
      event.target.closest('li').classList.add('selected')
    }

    function searchAndRender() {
      const text = document.querySelector('.search-prompt input').value.trim()

      if (text !== '') {
        const results = search(text)
        renderResults(results)
      } else {
        renderResults(feedItems)
      }

      selectFirst()
    }

    function search(query) {
      const needle = foldForSearch(query)
      return feedItems.filter(
        (item) =>
          item.searchTitle.includes(needle) ||
          item.searchDescription.includes(needle)
      )
    }

    function renderResults(results) {
      const ul = document.querySelector('.search-result ul')
      ul.innerHTML = ''

      results.slice(0, MAX_RESULTS).forEach((item) => {
        const li = document.createElement('li')
        const a = document.createElement('a')
        const title = document.createElement('div')
        const description = document.createElement('div')

        title.classList.add('search-result-title')
        title.textContent = item.title
        description.classList.add('search-result-description')
        // アーカイブ記事は description を持たない。素で渡すと
        // 説明文の欄に文字列 'undefined' が出るので空文字に落とす
        description.textContent = item.description ?? ''
        a.href = item.link

        li.addEventListener('mouseover', handleMouseover)

        a.appendChild(title)
        a.appendChild(description)
        li.appendChild(a)
        ul.appendChild(li)
      })
    }

    // 取りに行く先を RSS（/feed）から専用の検索インデックスに変えた。
    // /feed には Notion の 23 件しか載らず、アーカイブ 609 件が
    // 検索から引けなかったため（詳細は src/pages/search-index.json.ts）。
    // 取得は «モーダルを初めて開いたとき» のままで、ページ表示時には走らない
    async function fetchSearchIndex() {
      // dataset ではなく getAttribute + ?? を使っているのは型のため。
      // querySelector の戻りは Element | null なので、.dataset を直接
      // 読むと astro check が «Object is possibly null» と
      // «Property 'dataset' does not exist on type 'Element'» を出す
      const url =
        document
          .querySelector('.search-modal-container')
          ?.getAttribute('data-search-index') ?? ''

      const res = await fetch(url)
      if (res.status !== 200) {
        console.log(res.status)
        throw new Error('Failed to fetch search index')
      }

      // XML を DOMParser で舐める必要がなくなったぶん、
      // 起動時の処理は素の JSON.parse だけになった。
      //
      // 畳んだ文字列は «取得直後に 1 回だけ» 作って持たせる。打鍵のたびに
      // 632 件を normalize() し直すのは無駄で、検索は 1 文字ごとに走る。
      // title と description を繋げず別々に持つのは、繋げると
      // «タイトルの末尾と説明文の先頭にまたがる語» が当たってしまい、
      // 変更前に無かったヒットが増えるため
      feedItems = (await res.json()).map((item) => ({
        ...item,
        searchTitle: foldForSearch(item.title),
        searchDescription: foldForSearch(item.description),
      }))

      fetched = true
    }

    Array.from(document.getElementsByClassName('open-search-modal')).forEach(
      (element) => {
        element.addEventListener('click', openModal)
      }
    )
    document
      .getElementsByClassName('overlay')[0]
      .addEventListener('click', closeModal)
    document.addEventListener('keydown', handleKeydown)
  })
</script>
