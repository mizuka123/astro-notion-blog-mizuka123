---
import { getDatabase } from '../lib/notion/client'
import { getNavLink, getStaticFilePath } from '../lib/blog-helpers'
import { KATEX_CSS } from '../lib/katex-css'

// すべて省略可能。省略時は Notion のデータベース側の値にフォールバックする
export interface Props {
  title?: string
  description?: string
  path?: string
  ogImage?: string
  // robots に noindex を出す。«このページを検索結果に載せない» だけを
  // 意味し、canonical と og:url の有無には関わらない。
  // 以前はここで canonical と og:url も落としていたが、それは 404 ページの
  // «URL が固定されない» という別の性質に由来する挙動で、noindex とは
  // 条件が違う。実在する URL の noindex ページ（/category/ と /tag/ の
  // 薄い 186 枚）で og:url が消えると、SNS がシェアを同一オブジェクトに
  // 集約できなくなる。分けた先が下の noCanonical
  noindex?: boolean
  // canonical と og:url を出さない。
  // 404 ページのように «どの URL で配信されるか決まっていない» ページ用で、
  // 存在しない URL を「この URL が正規」と宣言させないためのもの。
  // noindex と別にしてあるのは、noAds と同じく «別の判断» だから。
  // noindex は「検索結果に載せない」、noCanonical は「正規 URL を名乗らない」で、
  // 404 ページだけがたまたま両方に当てはまる
  noCanonical?: boolean
  // 広告とアフィリエイトのスクリプトを出さない。
  // Google の Publisher Policies は «エラーページへの広告掲載を明確に禁止»
  // している（"Ads should not be placed on 'dead end' or no content screens
  // (e.g., Thank You, Exit, Error pages, etc.)"）。同じ Inventory value の
  // 項目が "with low-value content" の画面も禁じており、記事リンクが
  // 1〜2 本あるだけのタクソノミーページはこちらに当たる。違反はそのページの
  // 配信停止、繰り返せばアカウント単位の措置につながる。
  // noindex とは別にしてあるのは、「インデックスさせない」と「広告を出さない」が
  // 別の判断だから。片方だけ必要になったときに巻き添えで壊れないようにする。
  // «同じ判断から両方渡す» ページ（薄いタクソノミーページ）は、呼び出し側で
  // 2 つとも渡している。ここで noindex から導かないこと
  noAds?: boolean
  // 記事ページからだけ渡す公開日（'YYYY-MM-DD' か ISO 8601）。
  // これが入っているページだけ記事用の構造化データを出す。
  // 「記事かどうか」を path の形で判定しないのは、一覧も記事と同じ
  // /posts/ 配下（/posts/page/2、/posts/tag/gadget）にあり、
  // パスの正規表現では «記事ページだけ» を切り出せないため。
  // 公開日を持っているのは記事ページだけなので、それを目印にする
  articleDate?: string
  // 記事用の構造化データ（JSON-LD）の image。絶対 URL で渡す。
  // 空なら image プロパティ自体を出さない。
  // og:image と別に受け取るのは、og:image は «何か出さないと SNS の
  // カードが画像無しになる» ので共通画像に落とすが、JSON-LD の image は
  // Google の推奨項目（必須ではない）で、"Images must represent the
  // marked up content." とあるため。記事を表さない共通画像を出すより
  // 省く方が要件に沿う。以前は (ogImage || 共通画像) を出していたので、
  // og:image が共通画像のアーカイブ記事 377 件で共通画像を申告していた
  articleImage?: string
  // KaTeX の CSS を読み込む。本文に数式がある Notion 記事だけが渡す
  // （[slug].astro が src/lib/notion-equation.ts の hasEquation で判定）。
  //
  // 以前は全ページで読み込んでいた。実測（2026-09-24）では dist の
  // HTML 942 件すべてが katex.min.css を読み込み、KaTeX を描画している
  // （class="katex" を含む）HTML は 0 件。PageSpeed Insights
  // （archive/7668、モバイル）ではこの CSS が «レンダリングをブロックして
  // いるリクエスト» として 750 ms を占めていた。
  //
  // 数式を描画するコンポーネント（Equation.astro / RichText.astro）の側に
  // <link> を置く方法は採らなかった。コンポーネントの中の生の <link> は
  // <head> に移されず、描画された位置（<body> の中）にそのまま出るうえ、
  // 数式 1 つにつき 1 本ずつ重複して出る（Astro 5.1.3 で、<link> を持つ
  // コンポーネントを 2 回置いたページをビルドして確認）。ここで <head> に
  // 1 本だけ出す方が、読み込みの位置も回数も以前と同じに保てる。
  //
  // アーカイブ記事（LayoutMd.astro）、一覧ページ、404 などは渡さない。
  // アーカイブ 609 記事は Markdown で、KaTeX を通す経路がそもそも無い
  //
  // href の版と integrity は直書きせず、インストール済みの katex から
  // src/lib/katex-css.ts が求める（以前は 0.16.4 を直書きしていて、描画に
  // 使う katex 0.16.19 と食い違っていた。Issue #136）
  katexCss?: boolean
}

// このコンポーネントの利用箇所は Layout.astro と LayoutMd.astro だけで、
// どちらも path を必ず渡すため、ここのデフォルト '/' は実際には使われない。
// もし他から直接使うことになったら、path を省略した時点で canonical と
// og:url がトップページを指してしまうので必ず渡すこと
// （/archive/ と /contact/ で実際に起きた。Layout.astro のコメント参照）
const {
  title = '',
  description = '',
  path = '/',
  ogImage = '',
  noindex = false,
  noCanonical = false,
  noAds = false,
  articleDate = '',
  articleImage = '',
  katexCss = false,
} = Astro.props

const database = await getDatabase()

const siteTitle = title ? `${title} - ${database.Title}` : database.Title
const siteDescription = description ? description : database.Description
const siteURL = new URL(getNavLink(path), Astro.site).toString()
// author / publisher の url に使うサイトのトップ。
// getNavLink('/') を通すのは BASE_PATH を設定したときに揃えるため
const siteHomeURL = new URL(getNavLink('/'), Astro.site).toString()
const siteOGImage = new URL(
  getStaticFilePath('/default-og-image.png'),
  Astro.site
)

/*
 * 記事ページの構造化データ（JSON-LD）。
 *
 * 全 643 ページのうち JSON-LD を持つページが 0 だった。検索エンジンには
 * 「いつ書かれた、誰の、何という記事か」を HTML から推測させるしかなく、
 * 検索結果に日付や記事としての扱いが出ない。
 *
 * ここで組み立てているのは、この同じファイルが <title> / description /
 * canonical / og:image を導出しているから。別のコンポーネントに切り出すと
 * 同じ導出が 2 か所になり、片方だけ直したときに «構造化データとページの
 * 表示が食い違う» 状態になる。Google はこの不一致をスパムとして扱う。
 * 逆にここに置く限り、出る値は meta タグと必ず同じものになる。
 *
 * dateModified は出さない。アーカイブ記事の frontmatter（layout / title /
 * date / categories / tags / coverImage）にも Notion のデータベースにも
 * 更新日に当たる項目が無く、公開日で代用すれば «更新していないのに
 * 更新したと申告する» ことになる。取れない値は出さない。
 * publisher.logo も同じ理由で出さない。データベースのアイコンは
 * emoji のこともあり、画像でも Google が求める比率を満たす保証が無い
 */
const articleJsonLd =
  articleDate && title
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description: siteDescription,
        // 空のときはキーごと出さない。キーの位置は以前と同じにしてあり、
        // 値が同じページの出力は 1 バイトも変わらない
        ...(articleImage ? { image: articleImage } : {}),
        datePublished: articleDate,
        mainEntityOfPage: { '@type': 'WebPage', '@id': siteURL },
        url: siteURL,
        // 著者名も発行者名も Notion のデータベースタイトルから取る。
        // 個人名は Notion 側にもリポジトリにも無いので、実在しない名前を
        // 作らず、og:site_name と同じ値（＝ブログ自体）を主体として出す。
        //
        // url を添えるのは Google が明示的に推奨しているため。Article の
        // 構造化データのドキュメントに「A link to a web page that uniquely
        // identifies the author」「helps Google better understand and
        // represent the author」とある。同名の別サイトと区別が付く
        author: {
          '@type': 'Organization',
          name: database.Title,
          url: siteHomeURL,
        },
        publisher: {
          '@type': 'Organization',
          name: database.Title,
          url: siteHomeURL,
        },
      }
    : null

// JSON をそのまま <script> に入れると、記事タイトルや説明文に
// '</script>' や '<!--' が含まれたときにスクリプトがそこで閉じ、
// 以降の <head> が壊れる。'<' をユニコードエスケープに置き換えれば JSON としての
// 値は変わらないまま無害化できる。実測では現在の 632 記事に該当は
// 無いが、記事は Notion から増えるので入力側の性質には頼らない
const articleJsonLdText = articleJsonLd
  ? JSON.stringify(articleJsonLd).replace(/</g, '\\u003c')
  : ''
---

<meta name="viewport" content="width=device-width, initial-scale=1.0" />
{
  /*
    この robots の meta が出す文字列を、astro.config.mjs の isIndexablePage が
    «正規表現で» 読んでいる（sitemap に載せるかどうかの判定が、出来上がった
    HTML に noindex が入っているかに依存している）。
    content の値を変えるときは astro.config.mjs も必ず一緒に直すこと。
    直し忘れても «ビルドも lint も通る» まま、186 ページが無言で sitemap に
    戻る（向こう側の正規表現は content の «一部に» noindex があれば拾う形に
    してあるので、'noindex, follow' のような追加なら壊れないが、
    'none' に変えるといった置き換えは通らない）。
    属性の順序には依存しないようにしてあるので、name と content を
    並べ替えるぶんには壊れない
  */
}
<meta
  name="robots"
  content={noindex ? 'noindex' : 'max-image-preview:large'}
/>
<meta charset="UTF-8" />
<meta name="generator" content={Astro.generator} />
<title>{siteTitle}</title>
<meta name="description" content={siteDescription} />
{!noCanonical && <link rel="canonical" href={siteURL} />}
{!noCanonical && <meta property="og:url" content={siteURL} />}
<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={siteDescription} />
<meta property="og:site_name" content={database.Title} />
<meta property="og:image" content={ogImage || siteOGImage} />
<meta name="twitter:title" content={siteTitle} />
<meta name="twitter:description" content={siteDescription} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage || siteOGImage} />
{
  /*
    is:inline を付けているのは、Astro に «中身を触らせない» ことを
    明示するため。set:html で入れた JSON は整形も最適化もされては困る
  */
}
{
  articleJsonLdText && (
    <script type="application/ld+json" is:inline set:html={articleJsonLdText} />
  )
}
{
  katexCss && (
    <link
      rel="stylesheet"
      href={KATEX_CSS.href}
      integrity={KATEX_CSS.integrity}
      crossorigin="anonymous"
    />
  )
}
{
  /*
    ValueCommerce LinkSwitch。ページ内の提携ショップへの素の URL を、実行時に
    アフィリエイトリンクへ自動変換する。記事ごとに ASP の管理画面でリンクを
    作る往復が要らなくなる。

    is:inline が必須。Astro は src の無い <script> を既定でモジュールとして
    バンドルするため、付けないと vc_pid がモジュールスコープに閉じ込められ、
    グローバルを見に来る vcdal.js から参照できない。スクリプトは読み込まれて
    いるのにリンクだけ変換されない、という気づきにくい壊れ方をする。

    var ではなく window に直接代入しているのは、外部スクリプトが読む
    グローバルであることを明示するため（トップレベルの var と等価）。
    vc_pid の定義が先に実行される必要があるので、2 つの順序は変えないこと
  */
}
{
  !noAds && (
    <Fragment>
      <script is:inline type="text/javascript">
        window.vc_pid = '892700549'
      </script>
      <script
        is:inline
        type="text/javascript"
        src="//aml.valuecommerce.com/vcdal.js"
        async
      />

      <script
        type="text/javascript"
        src="//mlb.valuecommerce.com/mylinkbox.js"
        async
      />
      <script
        async
        src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8748150415175448"
        crossorigin="anonymous"
      />
    </Fragment>
  )
}
<link rel="sitemap" href="/sitemap-index.xml">
