---
import { getDatabase } from '../lib/notion/client'
import { getNavLink, getStaticFilePath } from '../lib/blog-helpers'

// すべて省略可能。省略時は Notion のデータベース側の値にフォールバックする
export interface Props {
  title?: string
  description?: string
  path?: string
  ogImage?: string
}

// このコンポーネントの利用箇所は Layout.astro と LayoutMd.astro だけで、
// どちらも path を必ず渡すため、ここのデフォルト '/' は実際には使われない。
// もし他から直接使うことになったら、path を省略した時点で canonical と
// og:url がトップページを指してしまうので必ず渡すこと
// （/archive/ と /contact/ で実際に起きた。Layout.astro のコメント参照）
const { title = '', description = '', path = '/', ogImage = '' } = Astro.props

const database = await getDatabase()

const siteTitle = title ? `${title} - ${database.Title}` : database.Title
const siteDescription = description ? description : database.Description
const siteURL = new URL(getNavLink(path), Astro.site).toString()
const siteOGImage = new URL(
  getStaticFilePath('/default-og-image.png'),
  Astro.site
)
---

<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="max-image-preview:large" />
<meta charset="UTF-8" />
<meta name="generator" content={Astro.generator} />
<title>{siteTitle}</title>
<meta name="description" content={siteDescription} />
<link rel="canonical" href={siteURL} />
<meta property="og:url" content={siteURL} />
<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={siteDescription} />
<meta property="og:site_name" content={database.Title} />
<meta property="og:image" content={ogImage || siteOGImage} />
<meta name="twitter:title" content={siteTitle} />
<meta name="twitter:description" content={siteDescription} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage || siteOGImage} />
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/katex@0.16.4/dist/katex.min.css"
  integrity="sha384-vKruj+a13U8yHIkAyGgK1J3ArTLzrFGBbBc0tDp4ad/EyewESeXE/Iv67Aj8gKZ0"
  crossorigin="anonymous"
/>
{
  /*
    ValueCommerce LinkSwitch。ページ内の提携ショップへの素の URL を、実行時に
    アフィリエイトリンクへ自動変換する。記事ごとに ASP の管理画面でリンクを
    作る往復が要らなくなる。

    is:inline が必須。Astro は src の無い <script> を既定でモジュールとして
    バンドルするため、付けないと vc_pid がモジュールスコープに閉じ込められ、
    グローバルを見に来る vcdal.js から参照できない。スクリプトは読み込まれて
    いるのにリンクだけ変換されない、という気づきにくい壊れ方をする。

    var ではなく window に直接代入しているのは、外部スクリプトが読む
    グローバルであることを明示するため（トップレベルの var と等価）。
    vc_pid の定義が先に実行される必要があるので、2 つの順序は変えないこと
  */
}
<script is:inline type="text/javascript">
  window.vc_pid = '892700549'
</script>
<script
  is:inline
  type="text/javascript"
  src="//aml.valuecommerce.com/vcdal.js"
  async></script>

<script type="text/javascript" src="//mlb.valuecommerce.com/mylinkbox.js" async></script>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8748150415175448"
crossorigin="anonymous"></script>
<link rel="sitemap" href="/sitemap-index.xml">
