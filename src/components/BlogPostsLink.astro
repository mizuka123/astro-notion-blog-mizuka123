---
import type { Post } from '../lib/interfaces.ts'
import { getIconImageURL, getPostLink } from '../lib/blog-helpers.ts'

export interface Props {
  heading: string
  posts: Post[]
}

const { heading, posts } = Astro.props

// アイコンの src は記事ごとに一度だけ求めて引ける形にしておく
// （テンプレート内で分岐と src の 2 箇所から参照するため）。
// file タイプ（署名付き URL が失効する）はローカルパスに差し替わる
const iconImageURLs = new Map<string, string | undefined>(
  posts.map((post: Post) => [
    post.PageId,
    getIconImageURL(post.Icon, `page_id: ${post.PageId}`),
  ])
)
---

{
  /*
    中身が無いときはセクションごと出さない。
    以前は見出しの下に「There are no contents yet」を出していたが、
    「おすすめ記事」は Notion の Rank が付いた記事が 1 件も無いため
    全 642 ページで空になっており、読者には壊れているように見えていた。
    サイドバーの補助的な枠なので、出せるものが無いなら黙って消す
  */
}
{
  posts.length > 0 && (
    <div class="blog-posts-link">
      <h2>{heading}</h2>
      <ul>
        {posts.map((post: Post) => (
          <li>
            <a
              href={getPostLink(post.Slug)}
              title={`${
                post.Icon?.Type === 'emoji' ? post.Icon.Emoji : ''
              }${post.Title}`}
            >
              {post.Icon && post.Icon.Type === 'emoji' ? (
                <>
                  <span>{post.Icon.Emoji}</span>
                  {post.Title}
                </>
              ) : iconImageURLs.get(post.PageId) ? (
                <>
                  <img
                    src={iconImageURLs.get(post.PageId)}
                    alt=""
                  />
                  {post.Title}
                </>
              ) : (
                post.Title
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .blog-posts-link {
  }
  .blog-posts-link h2 {
    margin: 0;
    padding-left: 0.4rem;
    color: #777;
    font-size: 0.95rem;
  }
  .blog-posts-link ul {
    list-style-type: none;
    padding: 0;
    margin-top: 0.4rem;
    margin-block-end: 1rem;
  }
  .blog-posts-link ul li {
  }
  .blog-posts-link ul li a {
    display: block;
    border-radius: var(--radius);
    padding: 0.4rem 0.4rem;
    line-height: 1.2rem;
    color: inherit;
    font-size: 0.95rem;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .blog-posts-link ul li a:hover {
    background-color: #ddd;
  }
  .blog-posts-link ul li a span,
  .blog-posts-link ul li a img {
    display: inline-block;
    margin-right: 0.2rem;
  }
  .blog-posts-link ul li a img {
    width: 1.25rem;
    height: 1.25rem;
    vertical-align: sub;
  }
</style>
