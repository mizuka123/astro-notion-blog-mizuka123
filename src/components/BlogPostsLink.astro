---
import { Post } from '../lib/interfaces.ts'
import { getIconImageURL, getPostLink } from '../lib/blog-helpers.ts'
import NoContents from './NoContents.astro'

export interface Props {
  heading: string
  posts: Post[]
}

const { heading, posts } = Astro.props

// アイコンの src は記事ごとに一度だけ求めて引ける形にしておく
// （テンプレート内で分岐と src の 2 箇所から参照するため）。
// file タイプ（署名付き URL が失効する）はローカルパスに差し替わる
const iconImageURLs = new Map<string, string | undefined>(
  posts.map((post: Post) => [
    post.PageId,
    getIconImageURL(post.Icon, `page_id: ${post.PageId}`),
  ])
)
---

<div class="blog-posts-link">
  <h2>{heading}</h2>
  {
    posts.length === 0 ? (
      <NoContents contents={posts} />
    ) : (
      <ul>
        {posts.map((post: Post) => (
          <li>
            <a
              href={getPostLink(post.Slug)}
              title={`${
                post.Icon?.Type === 'emoji' ? post.Icon.Emoji : ''
              }${post.Title}`}
            >
              {post.Icon && post.Icon.Type === 'emoji' ? (
                <>
                  <span>{post.Icon.Emoji}</span>
                  {post.Title}
                </>
              ) : iconImageURLs.get(post.PageId) ? (
                <>
                  <img
                    src={iconImageURLs.get(post.PageId)}
                    alt="Post title icon in a link list"
                  />
                  {post.Title}
                </>
              ) : (
                post.Title
              )}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .blog-posts-link {
  }
  .blog-posts-link h3 {
    margin: 24px 0 0 0;
  .blog-posts-link h2 {
    margin: 0;
    padding-left: 0.4rem;
    color: #777;
    font-size: 0.95rem;
  }
  .blog-posts-link ul {
    list-style-type: none;
    padding: 0;
    margin-top: 0.4rem;
    margin-block-end: 1rem;
  }
  .blog-posts-link ul li {
  }
  .blog-posts-link ul li a {
    display: block;
    border-radius: var(--radius);
    padding: 0.4rem 0.4rem;
    line-height: 1.2rem;
    color: inherit;
    font-size: 0.95rem;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .blog-posts-link ul li a:hover {
    background-color: #ddd;
  }
  .blog-posts-link ul li a span,
  .blog-posts-link ul li a img {
    display: inline-block;
    margin-right: 0.2rem;
  }
  .blog-posts-link ul li a img {
    width: 1.25rem;
    height: 1.25rem;
    vertical-align: sub;
  }
</style>
