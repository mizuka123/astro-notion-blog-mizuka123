---
import type { Post } from '../lib/interfaces.ts'
import {
  getDateStr,
  getIconImageURL,
  getPostLink,
} from '../lib/blog-helpers.ts'

export interface Props {
  heading: string
  posts: Post[]
}

const { heading, posts } = Astro.props

// アイコンの src は記事ごとに一度だけ求めて引ける形にしておく
// （テンプレート内で分岐と src の 2 箇所から参照するため）。
// file タイプ（署名付き URL が失効する）はローカルパスに差し替わる
const iconImageURLs = new Map<string, string | undefined>(
  posts.map((post: Post) => [
    post.PageId,
    getIconImageURL(post.Icon, `page_id: ${post.PageId}`),
  ])
)

// 下のテンプレートで、アイコン（<span> / <img>）と {post.Title} は
// «同じ行に» 続けて書くこと。Astro 7 の Rust 製コンパイラは、式の中の
// 要素と {post.Title} の間の改行を compressHTML: true でも空白 1 つとして
// 残す（Astro 5 の Go 製コンパイラは消していた）。行を分けると
// 「📔 タイトル」のように間が空く
---

{
  /*
    中身が無いときはセクションごと出さない。
    以前は見出しの下に「There are no contents yet」を出していたが、
    「おすすめ記事」は Notion の Rank が付いた記事が 1 件も無いため
    全 642 ページで空になっており、読者には壊れているように見えていた。
    サイドバーの補助的な枠なので、出せるものが無いなら黙って消す
  */
}
{
  posts.length > 0 && (
    <div class="blog-posts-link">
      <h2>{heading}</h2>
      <ul>
        {posts.map((post: Post) => (
          <li>
            <a href={getPostLink(post.Slug)}>
              {post.Date && (
                <time datetime={post.Date}>{getDateStr(post.Date)}</time>
              )}
              <span class="title">
                {post.Icon && post.Icon.Type === 'emoji' ? (
                  <>
                    <span>{post.Icon.Emoji}</span>{post.Title}
                  </>
                ) : iconImageURLs.get(post.PageId) ? (
                  <>
                    <img src={iconImageURLs.get(post.PageId)} alt="" />{post.Title}
                  </>
                ) : (
                  post.Title
                )}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .blog-posts-link h2 {
    margin: 0;
    padding-left: 0.4rem;
    color: #777;
    font-size: 0.95rem;
  }
  .blog-posts-link ul {
    list-style-type: none;
    padding: 0;
    margin-top: 0.4rem;
    margin-block-end: 1rem;
  }
  /* 項目の間に線を引く。線が無いと、折り返したタイトルの 2 行目と
     次の記事の 1 行目の区別が付かない */
  .blog-posts-link ul li + li {
    border-top: 1px solid rgba(55, 53, 47, 0.12);
  }
  .blog-posts-link ul li a {
    display: block;
    border-radius: var(--radius);
    padding: 0.5rem 0.4rem;
    color: inherit;
    text-decoration: none;
  }
  /* 以前は 1 行に収めて末尾を「…」で切っていたが、スマホでは
     タイトルの半分ほどしか読めず、何の記事か分からなかった。
     全文を折り返して出す */
  .blog-posts-link ul li a .title {
    display: block;
    font-size: 0.95rem;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
  /* 日付があると「記事の一覧」だと一目で分かる */
  .blog-posts-link ul li a time {
    display: block;
    margin-bottom: 0.15rem;
    color: #777;
    font-size: 0.75rem;
    line-height: 1.2;
  }
  .blog-posts-link ul li a:hover {
    background-color: #ddd;
  }
  .blog-posts-link ul li a .title span,
  .blog-posts-link ul li a .title img {
    display: inline-block;
    margin-right: 0.2rem;
  }
  .blog-posts-link ul li a .title img {
    width: 1.25rem;
    height: 1.25rem;
    vertical-align: sub;
  }
</style>
