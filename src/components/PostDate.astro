---
import { Post } from '../lib/interfaces.ts'
import { getDateStr } from '../lib/blog-helpers.ts'

// このコンポーネントは post.Date だけを読む。Post 全体を要求すると、
// 日付しか持たない呼び出し側（LayoutMd）がダミーの値で埋める必要が出るため、
// 必要なフィールドだけを宣言する（Post 全体も代入可能）
export interface Props {
  post: Pick<Post, 'Date'>
}

const { post } = Astro.props
---

<div class="post-date">
  {post.Date ? getDateStr(post.Date) : ''}
</div>

<style>
  .post-date {
    padding: 0 0 0.3rem;
    font-size: 0.9rem;
  }
</style>
