---
import { ENABLE_LIGHTBOX } from '../../server-constants.ts'
import * as interfaces from '../../lib/interfaces'
import { filePath } from '../../lib/blog-helpers'
import Caption from './Caption.astro'

export interface Props {
  block: interfaces.Block
}

const { block } = Astro.props

let image = ''
if (block.Image.External) {
  image = block.Image.External.Url
} else if (block.Image.File) {
  image = filePath(new URL(block.Image.File.Url))
}

// alt には Notion のキャプションをプレーンテキストにして使う。リンクや
// 装飾が付いていても PlainText には文字だけが入っている。キャプションが
// 無ければ空にする。以前の固定文字列 «Image in a image block» は画像の
// 説明になっておらず、読み上げでは英語の無意味な文を聞かせるだけだった
const alt = (block.Image?.Caption ?? [])
  .map((richText: interfaces.RichText) => richText.PlainText)
  .join('')
  .trim()
---

<figure class="image">
  {
    image && (
      <div>
        <div>
          {ENABLE_LIGHTBOX ? (
            <a data-fslightbox href={image} data-type="image">
              <img src={image} alt={alt} loading="lazy" />
            </a>
          ) : (
            <img src={image} alt={alt} loading="lazy" />
          )}
        </div>
        <Caption richTexts={block.Image.Caption} />
      </div>
    )
  }
</figure>

<style>
  .image {
    display: flex;
    margin: 0.2rem auto 0;
  }
  .image > div {
    margin: 0 auto;
  }
  .image > div > div {
  }
  .image > div > div img {
    display: block;
    max-width: 100%;
  }
</style>
