---
import * as interfaces from '../../lib/interfaces.ts'
import { buildHeadingId } from '../../lib/blog-helpers.ts'
import { notionHeadingTag } from '../../lib/notion-heading-level.ts'
import RichText from './RichText.astro'
import NotionBlocks from '../NotionBlocks.astro'

export interface Props {
  block: interfaces.Block
  headings: interfaces.Block[]
}

const { block, headings } = Astro.props

const id = buildHeadingId(block.Heading2)

// 変更前は固定で h4 だった。段の決め方は Heading1.astro と同じで、
// 中身は src/lib/notion-heading-level.ts にある。
// heading_1 を使っていない記事（実測では /posts/privacy の 1 本）では
// この heading_2 が本文の先頭段になるので h3 ではなく h2 になる
const Tag = notionHeadingTag('heading_2', headings)
---

{
  block.Heading2.IsToggleable ? (
    <details class="toggle">
      <summary>
        <a href={`#${id}`} id={id}>
          <Tag class="heading-2">
            {block.Heading2.RichTexts.map((richText: interfaces.RichText) => (
              <RichText richText={richText} />
            ))}
          </Tag>
        </a>
      </summary>
      <div>
        {block.Heading2.Children && (
          <NotionBlocks blocks={block.Heading2.Children} headings={headings} />
        )}
      </div>
    </details>
  ) : (
    <a href={`#${id}`} id={id}>
      <Tag class="heading-2">
        {block.Heading2.RichTexts.map((richText: interfaces.RichText) => (
          <RichText richText={richText} />
        ))}
      </Tag>
    </a>
  )
}

<style>
  /*
   * セレクタが h4 から .heading-2 に変わっているのは、出力するタグが
   * 記事によって h2 / h3 と変わるため。
   *
   * padding / font-weight / line-height は «タグ名で決まる宣言» の打ち消し。
   * 変更前の h4 にはこのサイトの CSS が 1 行も無く、ブラウザ既定の
   * font-weight: bold（＝700）・padding 0・line-height normal だった。
   * h2 になると src/layouts/Layout.astro の h2（padding: 1em 1.1em）と
   * src/styles/layout-global.css の h2（font-weight: normal /
   * line-height: 1.3）が当たってしまうので、既定値を明示して据え置く
   */
  .heading-2 {
    margin: 1em 0 0.3em;
    padding: 0;
    color: var(--fg);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: normal;
  }
  @media (max-width: 640px) {
    .heading-2 {
      font-size: 1.2rem;
    }
  }

  .toggle {
    margin: 1.6rem 0 0;
  }
  @media (max-width: 640px) {
    .toggle {
      margin: 1.2rem 0 0;
    }
  }

  .toggle > summary {
    cursor: pointer;
  }

  .toggle > summary > a {
    display: inline;
  }

  .toggle > summary > a > .heading-2 {
    display: inline;
  }

  .toggle > div {
    margin-left: 1em;
  }
</style>
