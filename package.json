{
  "name": "astro-notion-blog",
  "type": "module",
  "version": "0.12.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:local": "node --env-file-if-exists=.env scripts/check-local-env.mjs && node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs build",
    "dev:local": "node --env-file-if-exists=.env scripts/check-local-env.mjs && node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs dev",
    "build:cached": "npm run cache:fetch && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint src",
    "format": "npx prettier --write .",
    "notion": "node --env-file-if-exists=.env scripts/notion-cli.mjs",
    "cache:fetch": "node scripts/blog-contents-cache.cjs",
    "cache:purge": "nx reset && rm -rf tmp/*",
    "_fetch-notion-blocks": "node scripts/retrieve-block-children.cjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.3",
    "@astrojs/react": "^7.1.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@iconify-json/octicon": "^1.2.2",
    "@notionhq/client": "^5.16.0",
    "@supercharge/promise-pool": "^3.2.0",
    "astro": "^7.4.0",
    "astro-icon": "^1.2.0",
    "async-retry": "^1.3.3",
    "exif-be-gone": "^1.5.1",
    "katex": "^0.16.19",
    "mermaid": "^11.4.1",
    "metascraper": "^5.45.28",
    "metascraper-description": "^5.45.28",
    "metascraper-image": "^5.45.28",
    "metascraper-title": "^5.45.28",
    "prismjs": "^1.29.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@nrwl/nx-cloud": "^19.1.0",
    "@types/async-retry": "^1.4.9",
    "@types/js-base64": "^3.3.1",
    "@types/katex": "^0.16.7",
    "@types/metascraper": "^5.14.3",
    "@types/metascraper-description": "^5.14.5",
    "@types/metascraper-image": "^5.14.5",
    "@types/metascraper-title": "^5.14.5",
    "@types/prismjs": "^1.26.5",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@typescript-eslint/typescript-estree": "^8.58.0",
    "cli-progress": "^3.12.0",
    "eslint": "^10.2.0",
    "eslint-plugin-astro": "^3.2.1",
    "nx": "20.3.1",
    "turndown": "^7.2.4"
  },
  "nx": {
    "targets": {
      "_fetch-notion-blocks": {
        "inputs": [
          "!{projectRoot}/**/*",
          "!{projectRoot}/**/.*",
          "!{projectRoot}/**/.*/**/*",
          {
            "env": "DATABASE_ID"
          }
        ],
        "outputs": [
          "{projectRoot}/tmp/{options.pageId}"
        ]
      }
    },
    "includedScripts": [
      "_fetch-notion-blocks"
    ]
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.60.1",
    "@nx/nx-linux-x64-gnu": "20.3.1"
  },
  "volta": {
    "node": "24.22.0"
  },
  "overrides": {
    "re2": "^1.26.1"
  }
}
